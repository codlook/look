# --- Yayin hatti: TARIFI izle, CIKTIYI yok say ---
# Drift kok-nedeni: izlenmeyen plesk/bin gunlerce stale kaldi -> yamasiz zip uretildi.
# Surum kontrolu ilk git status'ta gorurdu. Build script + paket kaynagi IZLENIR;
# derlenmis ikili/zip/rpm/dist CIKTIDIR, yok sayilir.
# (NOT: gitignore satir-ici yorum desteklemez — yorumlar ayri satirda.)
# VSCode eklentisi: KAYNAK izlenir; cikti (vsix paketi, node_modules, gecici) yok sayilir:
platforms/vscode/node_modules/
platforms/vscode/_vsix_tmp/
platforms/vscode/*.vsix
platforms/vscode/*.map
# Paket ciktilari:
platforms/**/*.zip
platforms/**/*.rpm
platforms/**/*.exe
platforms/**/*.vsix
# Derlenmis ikili (drift buradan cikti) + frontend cikti:
platforms/plesk/bin/
platforms/plesk/htdocs/bin/
platforms/plesk/htdocs/dist/
# Yerel kurulum testi + junk (bozuk komuttan kalma bos dizin):
platforms/plesk/test/
platforms/plesk;C/
# cpp/docker: yalniz uretim tarifi izlensin; test infra + cikti disarda:
cpp/docker/*
!cpp/docker/Dockerfile.production

