{
  "Route (GET)": {
    "prefix": "route",
    "body": [
      "route(\"${1|GET,POST,PUT,DELETE,PATCH|}\", \"${2:/items}/{id}\", function(\\$id) {",
      "\treturn response::json([\"id\" => \\$id])",
      "})"
    ],
    "description": "HTTP route — a handler parameter takes the path parameter of the same name ({id} → $id)"
  },
  "Route (arrow / short)": {
    "prefix": "routefn",
    "body": [
      "route(\"${1|GET,POST|}\", \"${2:/path}\", fn() => response::json([\"${3:ok}\" => true]))"
    ],
    "description": "One-line arrow route — request data comes from request:: (request::get, request::json)"
  },
  "WebSocket route": {
    "prefix": "routews",
    "body": [
      "route(\"WS\", \"${1:/ws}\", function(\\$conn) {",
      "\tws::on(\\$conn, \"message\", function(\\$msg) {",
      "\t\tws::send(\\$conn, \"echo:\" . \\$msg)",
      "\t})",
      "})"
    ],
    "description": "WebSocket route (ws::on / ws::send)"
  },
  "SSE route": {
    "prefix": "routesse",
    "body": [
      "route(\"SSE\", \"${1:/events}\", function(\\$conn) {",
      "\tsse::send(\\$conn, \"${2:hello}\")",
      "})"
    ],
    "description": "Server-Sent Events route"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2:\\$arg}) {",
      "\t$0",
      "\treturn ${3:null}",
      "}"
    ],
    "description": "Function definition"
  },
  "Foreach": {
    "prefix": "foreach",
    "body": [
      "foreach (\\$${1:items} as \\$${2:item}) {",
      "\t$0",
      "}"
    ],
    "description": "foreach loop"
  },
  "Foreach (key => value)": {
    "prefix": "foreachkv",
    "body": [
      "foreach (\\$${1:map} as \\$${2:key} => \\$${3:value}) {",
      "\t$0",
      "}"
    ],
    "description": "foreach key => value"
  },
  "For": {
    "prefix": "for",
    "body": [
      "for (\\$${1:i} = 0 \\$${1:i} < ${2:10} \\$${1:i}++) {",
      "\t$0",
      "}"
    ],
    "description": "for loop (parts separated by spaces, no ;)"
  },
  "While": {
    "prefix": "while",
    "body": ["while (${1:condition}) {", "\t$0", "}"],
    "description": "while loop"
  },
  "If": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t$0", "}"],
    "description": "if block"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": ["if (${1:condition}) {", "\t$2", "} else {", "\t$0", "}"],
    "description": "if / else"
  },
  "Try / catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (\\$${2:err}) {",
      "\tlog::error(\\$${2:err})",
      "}"
    ],
    "description": "try / catch"
  },
  "Switch (Go-style, no break)": {
    "prefix": "switch",
    "body": [
      "switch (\\$${1:value}) {",
      "\tcase ${2:1}:",
      "\t\t$3",
      "\tcase ${4:2}, ${5:3}:",
      "\t\t$6",
      "\tdefault:",
      "\t\t$0",
      "}"
    ],
    "description": "switch / case (each case exits on its own, no break needed)"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "\t${2:field},", "}"],
    "description": "struct definition"
  },
  "DB query": {
    "prefix": "dbquery",
    "body": [
      "\\$${1:rows} = db::query(\"SELECT * FROM ${2:table} WHERE id = ?\", [\\$${3:id}])"
    ],
    "description": "Parameterized DB query"
  },
  "HTTP GET": {
    "prefix": "httpget",
    "body": ["\\$${1:res} = http::get(\"${2:https://api.example.com}\")"],
    "description": "HTTP GET request"
  },
  "Session start + get": {
    "prefix": "session",
    "body": [
      "session::start()",
      "\\$${1:user} = session::get(\"${2:user}\")"
    ],
    "description": "Start the session + read a value"
  },
  "JSON response": {
    "prefix": "resjson",
    "body": ["return response::json([\"${1:key}\" => \\$${2:value}])"],
    "description": "JSON response"
  },
  "404 / error response": {
    "prefix": "reserror",
    "body": ["return response::error(${1:404}, \"${2:not found}\")"],
    "description": "Error response"
  },
  "Use import": {
    "prefix": "use",
    "body": ["use ${1|http,json,string,db,mail,crypto|}"],
    "description": "Import a module"
  }
}
