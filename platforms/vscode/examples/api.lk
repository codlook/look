// LOOK example — a small JSON API. Open this file to try the extension:
//   • type   → autocompletion (module:: , $variable) + live error checking
//   • hover  → function signature
//   • Ctrl+F5 → run   ·   command palette "LOOK: Start Web Server"
// Note: LOOK statements do NOT end with a semicolon.
// A handler parameter takes the path parameter of the same name (e.g. {id});
// everything else about the request comes from request:: (request::json(), request::get(), ...).
use array
use json
use string
use type

// GET /status → status check (one-line arrow route)
// (/health is answered by the server itself — LOOK_HEALTH_PATH — so the app uses /status)
route("GET", "/status", fn() => response::json(["ok" => true, "time" => date::now()]))

// POST /notes → add a new note  (body: {"text": "..."} )
// Shared state is kept with app:: (persists across requests).
route("POST", "/notes", function() {
    $body = request::json()
    if ($body == null || $body["text"] == null) {
        return response::error(400, "the text field is required")
    }
    $notes = app::get("notes")
    if ($notes == null) {
        $notes = []
    }
    // array::push returns a new array — it does not change $notes in place
    $notes = array::push($notes, [
        "id"   => len($notes) + 1,
        "text" => string::trim($body["text"]),
    ])
    app::set("notes", $notes)
    return response::json(["added" => $notes[len($notes) - 1]], 201)
})

// GET /notes → list all notes
route("GET", "/notes", function() {
    $notes = app::get("notes")
    if ($notes == null) {
        $notes = []
    }
    return response::json(["total" => len($notes), "notes" => $notes])
})

// GET /notes/{id} → one note; $id is the {id} path parameter
route("GET", "/notes/{id}", function($id) {
    $notes = app::get("notes")
    if ($notes == null) {
        $notes = []
    }
    foreach ($notes as $n) {
        if ($n["id"] == type::to_int($id)) {
            return response::json($n)
        }
    }
    return response::error(404, "note not found")
})

// GET /search?q=... → search the note texts
route("GET", "/search", function() {
    $notes = app::get("notes")
    if ($notes == null) {
        $notes = []
    }
    $q = request::get("q")
    $found = array::filter($notes, fn($n) => string::contains($n["text"], $q))
    return response::json($found)
})
