{
  "name": "look-lang",
  "displayName": "LOOK Language",
  "description": "Full support for the LOOK language: syntax highlighting, live error checking (lk --check), autocompletion, hover signatures, snippets and Run/Serve/REPL shortcuts.",
  "version": "2.0.2",
  "publisher": "codlook",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Snippets", "Linters", "Formatters"],
  "keywords": ["look", "lk", "look-lang", "web", "scripting"],
  "homepage": "https://codlook.com",
  "repository": { "type": "git", "url": "https://github.com/codlook/look" },
  "bugs": { "url": "https://github.com/codlook/look/issues" },
  "galleryBanner": { "color": "#0f172a", "theme": "dark" },
  "activationEvents": ["onLanguage:look"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "look",
        "aliases": ["LOOK", "look", "lk"],
        "extensions": [".lk"],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./file-icon.svg", "dark": "./file-icon.svg" }
      }
    ],
    "grammars": [
      {
        "language": "look",
        "scopeName": "source.look",
        "path": "./syntaxes/look.tmLanguage.json"
      }
    ],
    "snippets": [
      { "language": "look", "path": "./snippets/look.json" }
    ],
    "commands": [
      { "command": "look.run",   "title": "LOOK: Run File (lk)",                    "icon": "$(play)" },
      { "command": "look.serve", "title": "LOOK: Start Web Server (lk-fcgi http)",  "icon": "$(server-process)" },
      { "command": "look.repl",  "title": "LOOK: Open REPL (lk repl)",              "icon": "$(terminal)" },
      { "command": "look.check", "title": "LOOK: Check This File (lk --check)" }
    ],
    "menus": {
      "editor/title/run": [
        { "command": "look.run",   "when": "resourceLangId == look", "group": "navigation@1" },
        { "command": "look.serve", "when": "resourceLangId == look", "group": "navigation@2" }
      ],
      "editor/context": [
        { "command": "look.run",   "when": "resourceLangId == look", "group": "look@1" },
        { "command": "look.repl",  "when": "resourceLangId == look", "group": "look@2" }
      ]
    },
    "keybindings": [
      { "command": "look.run", "key": "ctrl+f5", "when": "resourceLangId == look" }
    ],
    "configuration": {
      "title": "LOOK",
      "properties": {
        "look.binaryPath": {
          "type": "string",
          "default": "lk",
          "description": "Path to the 'lk' executable. Give the full path if it is not on PATH (e.g. C:\\\\look\\\\lk.exe or /usr/local/bin/lk)."
        },
        "look.fcgiPath": {
          "type": "string",
          "default": "lk-fcgi",
          "description": "Path to the 'lk-fcgi' web server executable (used by the LOOK: Start Web Server command)."
        },
        "look.serve.port": {
          "type": "number",
          "default": 7400,
          "description": "Port used by the LOOK: Start Web Server command."
        },
        "look.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable live error checking (parse errors + calls to undefined functions, via lk --check)."
        },
        "look.diagnostics.run": {
          "type": "string",
          "enum": ["onType", "onSave"],
          "default": "onType",
          "description": "When checking runs: while typing (onType, ~400ms delay) or on save (onSave)."
        }
      }
    }
  }
}
