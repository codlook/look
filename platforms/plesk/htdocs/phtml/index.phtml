<script>
const LK_BASE = location.pathname.replace(/\/+$/, '') + '/index.php';

// ── Navigation ────────────────────────────────────────────────────────────────
const LK_TITLES = { dash:['Dashboard','system status & applications'], apps:['Application Manager','manage your domains'], logs:['Logs','service journals'], docs:['Documentation','LOOK usage guide'] };
function lkNav(v){
  document.querySelectorAll('.lk-view').forEach(s=>s.classList.remove('active'));
  document.getElementById('view-'+v).classList.add('active');
  document.querySelectorAll('.lk-navi').forEach(n=>n.classList.toggle('active',n.dataset.view===v));
  document.getElementById('lkTitle').textContent=LK_TITLES[v][0];
  document.getElementById('lkDesc').textContent=LK_TITLES[v][1];
}

// ── Toast ─────────────────────────────────────────────────────────────────────
function lkToast(msg, ok=true){
  const w=document.getElementById('lkToasts'), el=document.createElement('div');
  el.className='lk-toast '+(ok?'lk-tok':'lk-terr'); el.append(msg); w.appendChild(el);
  setTimeout(()=>{el.style.transition='opacity .3s,transform .3s';el.style.opacity='0';el.style.transform='translateX(16px)';setTimeout(()=>el.remove(),320);},2600);
}
async function lkApi(data){
  const r=await fetch(LK_BASE,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(data)});
  return r.json();
}

// ── Status (hem dashboard hem apps satirlari) ──────────────────────────────────
const ST_LABELS={active:'Running',inactive:'Stopped',failed:'Failed',unknown:'Unknown'};
function lkPaintStatus(id,state){
  const el=document.getElementById(id); if(!el) return;
  el.className='lk-status lk-st-'+(ST_LABELS[state]?state:'unknown');
  el.querySelector('.lk-slabel').textContent=ST_LABELS[state]||state;
}
function lkSetStatus(svc,state){
  lkPaintStatus('lkst-'+svc,state); lkPaintStatus('lkdst-'+svc,state);
  const tb=document.getElementById('lktog-'+svc);
  if(tb) tb.textContent = state==='active' ? '■ Stop' : '▶ Start';
}
async function lkLoadStatus(svc){
  try{const d=await lkApi({action:'status',svc});lkSetStatus(svc,d.state||'unknown');}
  catch{lkSetStatus(svc,'unknown');}
}
function lkRefresh(){
  document.querySelectorAll('tr[data-svc]').forEach(row=>lkLoadStatus(row.dataset.svc));
}
document.addEventListener('DOMContentLoaded',lkRefresh);

// ── Live sparklines (gercek veri, periyodik ornekleme) ─────────────────────────
const LK_HIST={cpu:[],ram:[],disk:[]};
function lkSpark(id,val){
  const h=LK_HIST[id]; if(!h) return;
  h.push(val); if(h.length>28) h.shift();
  const svg=document.getElementById('sp-'+id); if(!svg) return;
  const W=88,H=30,n=h.length; if(n<2){return;}
  const pts=h.map((v,i)=>[ (i/(n-1))*W, H-2-(Math.max(0,Math.min(100,v))/100)*(H-4) ]);
  const line=pts.map(p=>p[0].toFixed(1)+','+p[1].toFixed(1)).join(' ');
  svg.querySelector('polyline').setAttribute('points',line);
  svg.querySelector('polygon').setAttribute('points','0,'+H+' '+line+' '+W+','+H);
}
async function lkPollStats(){
  try{
    const s=await lkApi({action:'sysstats'});
    const set=(id,val,sub,pct)=>{
      const sv=document.getElementById('sv-'+id); if(sv) sv.innerHTML=val;
      const ss=document.getElementById('ss-'+id); if(ss) ss.textContent=sub;
      const tr=document.getElementById('tr-'+id);
      if(tr){tr.className='lk-track'+(pct>=90?' crit':(pct>=75?' warn':''));tr.querySelector('i').style.width=Math.max(2,pct)+'%';}
    };
    set('cpu',(s.cpu|0)+'<small>%</small>',(s.cores|0)+' cores · load '+(s.load||''),s.cpu|0);
    set('ram',(s.ram_pct|0)+'<small>%</small>',(s.ram_used|0)+' / '+(s.ram_total|0)+' MB',s.ram_pct|0);
    set('disk',(s.disk_pct|0)+'<small>%</small>','root partition ( / )',s.disk_pct|0);
    lkSpark('cpu',s.cpu|0); lkSpark('ram',s.ram_pct|0); lkSpark('disk',s.disk_pct|0);
  }catch{}
}
lkPollStats(); setInterval(lkPollStats,4000);

// ── Add form ──────────────────────────────────────────────────────────────────
function lkDomChange(){
  const d=document.getElementById('lkFdom').value, p=d.split('.').slice(1).join('.');
  document.getElementById('lkFscript').value=`/var/www/vhosts/${p}/${d}/index.lk`;
  lkApi({action:'next_port'}).then(r=>{document.getElementById('lkFport').value=r.port;});
}
function lkScrollAdd(){document.getElementById('lkAddBox').scrollIntoView({behavior:'smooth'});document.getElementById('lkFdom').focus();}
document.addEventListener('DOMContentLoaded',lkDomChange);
async function lkAdd(){
  const btn=document.getElementById('lkAddBtn'),log=document.getElementById('lkAddLog');
  btn.disabled=true;btn.textContent='Starting…';log.style.display='block';log.textContent='$ enable.sh…';
  const d=await lkApi({action:'add',domain:lkV('lkFdom'),script:lkV('lkFscript'),workers:lkV('lkFwork'),mode:lkV('lkFmode'),port:lkV('lkFport')});
  log.textContent=d.out||d.error||'';btn.disabled=false;btn.textContent='Add & Start';
  if(d.ok){lkToast('Domain added');setTimeout(()=>location.reload(),1000);}else lkToast(d.error||'Error',false);
}
const lkV=id=>document.getElementById(id).value;

// ── Actions dropdown ───────────────────────────────────────────────────────────
function lkCloseMenus(){document.querySelectorAll('.lk-menu.open').forEach(m=>m.classList.remove('open'));}
function lkMenu(e,svc){
  e.stopPropagation();
  const m=document.getElementById('lkmenu-'+svc), open=m.classList.contains('open');
  lkCloseMenus(); if(open) return;
  const r=e.currentTarget.getBoundingClientRect();
  m.classList.add('open');                 // önce göster ki ölçülebilsin
  const mw=m.offsetWidth, mh=m.offsetHeight;
  let left=Math.max(8, r.right-mw);
  let top=r.bottom+4;
  if(top+mh>window.innerHeight-8) top=Math.max(8, r.top-4-mh); // alta sığmazsa yukarı aç
  m.style.left=left+'px'; m.style.top=top+'px';
}
document.addEventListener('click',lkCloseMenus);
// içerik/pencere kaydırılınca menü kapansın (fixed konum kaymasın)
window.addEventListener('scroll',lkCloseMenus,true);
document.addEventListener('DOMContentLoaded',()=>{const b=document.querySelector('.lk-body');if(b)b.addEventListener('scroll',lkCloseMenus);});

async function lkToggle(svc,domain){
  const el=document.getElementById('lkst-'+svc), active=el?.classList.contains('lk-st-active');
  if(el){el.className='lk-status lk-st-loading';el.querySelector('.lk-slabel').textContent='working…';}
  const d=active?await lkApi({action:'stop',svc,domain}):await lkApi({action:'start',svc});
  if(d.state||d.ok){lkSetStatus(svc,d.state||(active?'inactive':'active'));lkToast(active?'Stopped':'Started');}
  else{lkToast(d.error||'Error',false);lkLoadStatus(svc);}
}
async function lkRestart(domain,svc){
  const el=document.getElementById('lkst-'+svc);
  if(el){el.className='lk-status lk-st-loading';el.querySelector('.lk-slabel').textContent='restarting…';}
  const d=await lkApi({action:'restart',domain});
  lkSetStatus(svc,d.state||(d.ok?'active':'unknown'));lkToast(d.ok?'Restarted':(d.error||'Error'),d.ok);
}
async function lkDelete(domain,svc){
  if(!confirm(`Remove "${domain}"?\nThe service will be stopped.`))return;
  const row=document.getElementById('lkrow-'+svc); if(row)row.style.opacity='.4';
  const d=await lkApi({action:'delete',domain,svc});
  if(d.ok){row?.remove();lkToast('Removed');if(!document.querySelector('tr[data-svc]'))location.reload();}
  else{if(row)row.style.opacity='';lkToast(d.error||'Error',false);}
}

// ── Edit (config) modal ────────────────────────────────────────────────────────
function lkEdit(data){
  document.getElementById('lkESvc').value=data.svc;document.getElementById('lkEDom').value=data.domain;
  document.getElementById('lkEScript').value=data.script;document.getElementById('lkEWork').value=data.workers;
  document.getElementById('lkEMode').value=data.mode;document.getElementById('lkEPort').value=data.port;
  document.getElementById('lkEditLog').style.display='none';document.getElementById('lkModal').classList.add('open');
}
function lkCloseModal(){document.getElementById('lkModal').classList.remove('open');}
document.getElementById('lkModal').addEventListener('click',e=>{if(e.target===e.currentTarget)lkCloseModal();});
async function lkSaveEdit(){
  const btn=document.getElementById('lkESave'),log=document.getElementById('lkEditLog');
  btn.disabled=true;btn.textContent='Saving…';log.style.display='block';log.textContent='$ enable.sh…';
  const d=await lkApi({action:'edit',domain:lkV('lkEDom'),script:lkV('lkEScript'),workers:lkV('lkEWork'),mode:lkV('lkEMode'),port:lkV('lkEPort')});
  log.textContent=d.out||d.error||'';btn.disabled=false;btn.textContent='Save & Restart';
  if(d.ok){lkToast('Saved');setTimeout(()=>location.reload(),900);}else lkToast(d.error||'Error',false);
}

// ── Code editor ────────────────────────────────────────────────────────────────
async function lkOpenEditor(data){
  document.getElementById('lkEdDom').value=data.domain;
  document.getElementById('lkEdPath').textContent=data.script;
  document.getElementById('lkEdInfo').textContent=data.domain;
  const area=document.getElementById('lkEdArea'); area.value='# loading…'; area.disabled=true;
  document.getElementById('lkEdLog').style.display='none';
  document.getElementById('lkEdModal').classList.add('open');
  const d=await lkApi({action:'read_script',domain:data.domain});
  area.disabled=false;
  if(d.ok){area.value=d.content||''; if(!d.exists) lkToast('File does not exist — it will be created on save',true);}
  else{area.value='';lkToast(d.error||'Failed to read',false);}
  area.focus();
}
function lkCloseEditor(){document.getElementById('lkEdModal').classList.remove('open');}
document.getElementById('lkEdModal').addEventListener('click',e=>{if(e.target===e.currentTarget)lkCloseEditor();});
// TAB tuşu editörde girinti eklesin
document.getElementById('lkEdArea').addEventListener('keydown',function(e){
  if(e.key==='Tab'){e.preventDefault();const s=this.selectionStart,en=this.selectionEnd;
    this.value=this.value.slice(0,s)+'  '+this.value.slice(en);this.selectionStart=this.selectionEnd=s+2;}
});
async function lkSaveScript(){
  const btn=document.getElementById('lkEdSave'),log=document.getElementById('lkEdLog');
  btn.disabled=true;btn.textContent='Deploying…';log.style.display='block';log.textContent='$ saving + redeploying…';
  const d=await lkApi({action:'save_script',domain:document.getElementById('lkEdDom').value,content:document.getElementById('lkEdArea').value});
  log.textContent=d.out||d.error||'';btn.disabled=false;btn.textContent='Save & Redeploy';
  if(d.ok){lkToast('Saved & redeployed');}else lkToast(d.error||'Error',false);
}

// ── Monitor modal ──────────────────────────────────────────────────────────────
let LK_MON=null;  // {svc,domain,timer}
function lkFmtUptime(sec){sec=parseInt(sec)||0;const d=Math.floor(sec/86400),h=Math.floor(sec%86400/3600),m=Math.floor(sec%3600/60);
  if(d)return d+'d '+h+'h';if(h)return h+'h '+m+'m';return m+'m';}
function lkMonitor(svc,domain){
  LK_MON={svc,domain};
  document.getElementById('lkMonDom').textContent=domain;
  document.getElementById('lkMonModal').classList.add('open');
  ['mon-cpu','mon-rss','mon-pid','mon-conn','mon-port','mon-restart'].forEach(id=>document.getElementById(id).textContent='—');
  document.getElementById('lkMonLog').textContent='loading…';
  lkMonTick();
  LK_MON.timer=setInterval(lkMonTick,3000);
}
function lkMonClose(){document.getElementById('lkMonModal').classList.remove('open');if(LK_MON&&LK_MON.timer)clearInterval(LK_MON.timer);LK_MON=null;}
document.getElementById('lkMonModal').addEventListener('click',e=>{if(e.target===e.currentTarget)lkMonClose();});
async function lkMonRestart(){if(!LK_MON)return;const s=LK_MON;lkToast('Restarting…');await lkApi({action:'restart',domain:s.domain});setTimeout(lkMonTick,600);}
async function lkMonTick(){
  if(!LK_MON)return; const s=LK_MON;
  try{
    const d=await lkApi({action:'monitor',svc:s.svc}); if(!LK_MON||LK_MON.svc!==s.svc)return;
    const m=d.m||{};
    const active=(m.ActiveState==='active');
    lkPaintStatus('lkMonStatus',active?'active':(m.ActiveState==='failed'?'failed':'inactive'));
    const rss=parseInt(m.RSS)||0;
    document.getElementById('mon-cpu').innerHTML=(m.PCPU!==undefined?m.PCPU:'0')+'<small>%</small>';
    document.getElementById('mon-rss').innerHTML=rss>1024?(rss/1024).toFixed(1)+'<small> MB</small>':rss+'<small> KB</small>';
    document.getElementById('mon-pid').textContent=(m.MainPID&&m.MainPID!=='0')?m.MainPID:'—';
    document.getElementById('mon-conn').textContent=m.CONN!==undefined?m.CONN:'0';
    document.getElementById('mon-port').innerHTML=m.PORT?':'+m.PORT:'—';
    document.getElementById('mon-restart').textContent=m.NRestarts!==undefined?m.NRestarts:'0';
    document.getElementById('lkMonUp').textContent=active?('uptime '+lkFmtUptime(m.ETIMES)):(m.SubState||m.ActiveState||'');
    // log kuyrugu (son 30)
    const lg=await lkApi({action:'logs',svc:s.svc,n:30}); if(!LK_MON||LK_MON.svc!==s.svc)return;
    if(lg.ok){const el=document.getElementById('lkMonLog');const near=el.scrollTop+el.clientHeight>=el.scrollHeight-30;
      el.innerHTML=lkEsc(lg.log||'').split('\n').map(l=>/\b(ERR|ERROR|hata|failed|Fatal)\b/i.test(l)?'<span class="err">'+l+'</span>':/\b(WARN|uyar|warning)\b/i.test(l)?'<span class="warn">'+l+'</span>':/\b(OK|aktif|Listening|Started|haz)\b/i.test(l)?'<span class="ok">'+l+'</span>':l).join('\n');
      if(near)el.scrollTop=el.scrollHeight;}
  }catch{}
}

// ── Log kopyala (clipboard API + fallback) ─────────────────────────────────────
async function lkCopyLog(id){
  const el=document.getElementById(id); if(!el)return;
  const txt=el.innerText||el.textContent||'';
  if(!txt.trim()){lkToast('No logs to copy',false);return;}
  try{
    if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(txt);}
    else{const ta=document.createElement('textarea');ta.value=txt;ta.style.position='fixed';ta.style.opacity='0';
      document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();}
    lkToast('Logs copied to clipboard');
  }catch{lkToast('Copy failed',false);}
}

// ── Logs view ──────────────────────────────────────────────────────────────────
function lkViewLogs(svc){lkNav('logs');const sel=document.getElementById('lkLogSvc');if(sel)sel.value=svc;lkFetchLogs();}
function lkEsc(s){return s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));}
async function lkFetchLogs(){
  const svc=document.getElementById('lkLogSvc').value, out=document.getElementById('lkLogOut');
  if(!svc){out.textContent='No application.';return;}
  out.textContent='loading…';
  const d=await lkApi({action:'logs',svc,n:200});
  if(d.ok){
    const html=lkEsc(d.log||'(no logs)').split('\n').map(l=>{
      if(/\b(ERR|ERROR|hata|failed|Fatal)\b/i.test(l))return '<span class="err">'+l+'</span>';
      if(/\b(WARN|uyar|warning)\b/i.test(l))return '<span class="warn">'+l+'</span>';
      if(/\b(OK|aktif|ready|hazır|Listening|Started)\b/i.test(l))return '<span class="ok">'+l+'</span>';
      return l;
    }).join('\n');
    out.innerHTML=html; out.scrollTop=out.scrollHeight;
  }else out.textContent=d.error||'Failed to fetch logs';
}
</script>
