#!/bin/bash
# LOOK Language — install/upgrade (ROOT)
# Usage: look-setup [<domain> <script> <workers> <mode> <port> <env-file> <memory>]...
#
# Plesk runs the extension hooks (plib/scripts/post-install.php) as psaadm, NOT root
# (measured: euid=983); the hook used to run setup.sh as psaadm, which failed without being able to write to /opt/look,
# sudoers and the units, and the error was hidden → an update refreshed neither the binary nor
# the services. The root path is the one Plesk documents, pm_ApiCli::callSbin: post-install.php
# calls this script and passes the registered domains (from domains.json) as arguments.
#
# Does: (1) installs the LOOK binary into the new release directory (the old one stays), (2) removes the old sudoers rule, (3) rewrites each domain's service with enable.sh
# (the service runs as the domain user). A service that cannot run without root
# is STOPPED — a 1.1.x root service does not silently keep running. (4) Deletes the
# unused LOOK releases.
# Error = non-zero exit + message (Plesk shows it on install); no output is silenced.
set -u

MOD=/usr/local/psa/admin/htdocs/modules/look-lang
OPT=/opt/look
SCRIPTS="$MOD/scripts"
fail=0
err() { echo "ERROR: $*" >&2; fail=1; }

mkdir -p "$OPT/conf" /var/log/look

# ─── 1) LOOK releases side by side ──────────────────────────────────────────────
# Each release in its own directory: /opt/look/releases/<version>-<stamp>/{lk,lk-fcgi,lk-cgi}; /opt/look/lk* points to the newest
# (command line and new sites). A site is bound to a new release when its code passes that release's `lk --check`
# (enable.sh, step 3); a site that fails stays on the release it runs. A release no service uses is
# deleted in step 4. Changes are atomic (prepare next to it + mv): a running binary is never overwritten ("Text file busy").
REL="$OPT/releases"
rel_id() { "$1" --version 2>/dev/null | head -1 | sed -n 's/^LOOK \([0-9][0-9A-Za-z.+-]*\) (\([0-9a-f]\{7,\}\)[,)].*/\1-\2/p'; }
put_release() { # <source dir> <name>: lk, lk-fcgi, lk-cgi → $REL/<name>/ (if missing)
    [ -d "$REL/$2" ] && return 0
    rm -rf "$REL/.$2.new"; mkdir -p "$REL/.$2.new" || return 1
    for b in lk lk-fcgi lk-cgi; do
        [ -e "$1/$b" ] || continue
        install -m 755 "$(readlink -f "$1/$b")" "$REL/.$2.new/$b" || return 1
    done
    mv -T "$REL/.$2.new" "$REL/$2"
}
mkdir -p "$REL"; chmod 755 "$REL"
# An install coming from the unversioned layout: sites run /opt/look/lk-fcgi today — that binary is COPIED to its own release
# directory so a site whose code does not fit the new release can stay on it.
if [ -e "$OPT/lk-fcgi" ]; then
    case "$(readlink -f "$OPT/lk-fcgi")" in
        "$REL"/*) ;;
        *)  old="$(rel_id "$OPT/lk-fcgi")"
            if [ -n "$old" ]; then
                put_release "$OPT" "$old" && printf '%s\n' "$old" > "$OPT/conf/legacy-release" \
                    || err "could not keep the running LOOK ($old) in $REL"
            fi ;;
    esac
fi
# Releases that come with the package: bin/ is the newest (the command line and /opt/look/lk* point to it), bin-<line>/ is the latest release of
# the maintenance line (e.g. bin-1.0). A site that fails the newest release's check is moved to the newest release its code passes
# (enable.sh) — a site that cannot yet adapt to a breaking change at least gets the fix releases.
# Plesk unpacks the extension without execute permissions: the binaries are first installed with 755 into an intermediate directory, the release
# is read from there, then moved to the release directory.
install_bundled() { # <package dir> → prints the release name; error → stderr + 1 (inside a subshell err does not carry the failure)
    local src="$1" stage="$REL/.incoming" id
    rm -rf "$stage"; mkdir -p "$stage"
    for b in lk lk-fcgi lk-cgi; do
        [ -f "$src/$b" ] && { install -m 755 "$src/$b" "$stage/$b" || { echo "ERROR: could not stage $src/$b" >&2; return 1; }; }
    done
    id="$(rel_id "$stage/lk-fcgi")"
    if [ -z "$id" ]; then
        echo "ERROR: a LOOK binary of the extension does not say its version ($src/lk-fcgi --version)" >&2; rm -rf "$stage"; return 1
    elif [ -d "$REL/$id" ]; then
        rm -rf "$stage"
    else
        mv -T "$stage" "$REL/$id" || { echo "ERROR: could not install LOOK $id in $REL" >&2; return 1; }
    fi
    printf '%s\n' "$id"
}
new=""
bundled=" "
if [ -e "$MOD/bin/lk-fcgi" ]; then
    new="$(install_bundled "$MOD/bin")" || fail=1
    [ -n "$new" ] && bundled="$bundled$new "
fi
for d in "$MOD"/bin-*/; do
    [ -e "$d/lk-fcgi" ] || continue
    r="$(install_bundled "${d%/}")" || fail=1
    [ -n "$r" ] && bundled="$bundled$r "
done
if [ -n "$new" ] && [ -d "$REL/$new" ]; then
    for b in lk lk-fcgi lk-cgi; do
        [ -e "$REL/$new/$b" ] || continue
        ln -sfn "$REL/$new/$b" "$OPT/.$b.new" && mv -Tf "$OPT/.$b.new" "$OPT/$b" || err "could not point $OPT/$b at LOOK $new"
    done
fi
if [ ! -x "$OPT/lk-fcgi" ]; then
    err "the extension has no LOOK binary ($MOD/bin) and $OPT/lk-fcgi does not exist"
fi
if [ -x "$OPT/lk" ]; then echo "LOOK binary: $("$OPT/lk" --version 2>&1 | head -1)"; fi

# ─── 2) NO sudoers — the panel does root work through sbin/look-ctl (callSbin) ──
# The old releases' rule ('systemctl enable look-*' — '*' also covers spaces) gave psaadm
# root; it is removed on update.
if [ -e /etc/sudoers.d/look-lang ]; then
    rm -f /etc/sudoers.d/look-lang && echo "removed /etc/sudoers.d/look-lang (the panel no longer uses sudo)"
fi
echo 'export PATH="/opt/look:$PATH"' > /etc/profile.d/look.sh

# ─── 3) rewrite the services according to the new rule ─────────────────────────────
svc_of() { echo "look-$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g')"; }
stop_svc() { /bin/systemctl stop "$1" 2>/dev/null; /bin/systemctl disable "$1" 2>/dev/null; true; }
done_svcs=" "
while [ "$#" -ge 7 ]; do
    d="$1"; s="$2"; w="$3"; m="$4"; p="$5"; e="$6"; mem="$7"; shift 7
    svc="$(svc_of "$d")"; done_svcs="$done_svcs$svc "
    rc=0; out="$(/bin/bash "$SCRIPTS/enable.sh" "$d" "$s" "$w" "$m" "$p" "$e" "${mem:-auto}" 2>&1)" || rc=$?
    if [ "$rc" = 0 ]; then
        echo "$d: $(printf '%s\n' "$out" | grep -E '^(OK|WARNING)' | tr '\n' ' ')"
    elif [ "$rc" = 3 ]; then
        # The code fails this LOOK release's check and there is no older release the site could stay on:
        # the service is left alone (if it is running it keeps running), the panel shows the reason.
        err "$d: not moved to the new LOOK — $(printf '%s\n' "$out" | grep -E '^(ERROR|CHECK)' | head -3 | tr '\n' ' ')"
    else
        stop_svc "$svc"
        err "$d: the service was STOPPED — it cannot run as the domain's user: $(printf '%s\n' "$out" | grep -E 'ERROR' | head -1)"
    fi
done
[ "$#" = 0 ] || err "ignored $# trailing argument(s): domains are given as groups of 7"

# A unit written by the extension (Description signature) that has no record and carries no User= = a root service
for f in /etc/systemd/system/look-*.service; do
    [ -f "$f" ] || continue
    svc="$(basename "$f" .service)"
    case "$done_svcs" in *" $svc "*) continue ;; esac
    grep -q '^Description=LOOK FastCGI - ' "$f" || continue
    grep -q '^User=' "$f" && continue
    stop_svc "$svc"
    err "$svc was STOPPED: it ran as root and is not registered in the panel; add the domain again in the panel"
done

# ─── 4) Delete the LOOK releases no service uses ───────────────────────
# The newest and the packaged releases always stay; a release that appears in a service's ExecStart (whose site stays on the old release) stays.
in_use=" $(basename "$(dirname "$(readlink -f "$OPT/lk-fcgi" 2>/dev/null)")") ""$bundled"
for f in /etc/systemd/system/look-*.service; do
    [ -f "$f" ] || continue
    for r in $(grep -o "$REL/[^/ ]*/lk-fcgi" "$f" | sed "s#^$REL/##; s#/lk-fcgi\$##"); do in_use="$in_use$r "; done
done
for d in "$REL"/*/; do
    [ -d "$d" ] || continue
    r="$(basename "$d")"
    case "$in_use" in *" $r "*) continue ;; esac
    rm -rf "${REL:?}/$r" && echo "removed LOOK $r (no service uses it)"
done

exit "$fail"
