#!/bin/bash
# LOOK Language — the panel's root operations (ROOT, via pm_ApiCli::callSbin)
# Usage: look-ctl <action> <arguments>
#   enable  <domain> <script> <workers> <mode> <port> [<env-file> [<memory>]]
#   disable <svc> [<domain>] [remove]
#   start   <svc>
#   status  <svc>
#   logs    <svc> <lines>
#   monitor <svc>
#
# Previously the panel (psaadm) ran these via a sudoers rule. In sudoers '*' also matches spaces:
# the rule "systemctl enable look-*" also allowed "systemctl enable look-a /tmp/evil.service" and
# "systemctl stop look-a sshd" too → anyone able to run code as psaadm through a hole could
# escalate to root. Now there is NO sudoers; the only entry is this script: the action, argument count and service name
# (^look-[a-z0-9-]+$) are checked here. callSbin passes arguments without a shell (argv).
set -u
SCRIPTS=/usr/local/psa/admin/htdocs/modules/look-lang/scripts

die() { echo "ERROR: $*" >&2; exit 2; }
svc_ok() { [[ "$1" =~ ^look-[a-z0-9-]+$ ]] || die "invalid service name"; }
domain_ok() { [[ "$1" =~ ^[A-Za-z0-9.-]{1,253}$ ]] || die "invalid domain"; }

[ "$#" -ge 1 ] || die "no action"
action="$1"; shift
case "$action" in
    enable)
        [ "$#" -ge 5 ] && [ "$#" -le 7 ] || die "enable takes 5 to 7 arguments"
        domain_ok "$1"
        exec /bin/bash "$SCRIPTS/enable.sh" "$@" ;;
    disable)
        [ "$#" -ge 1 ] && [ "$#" -le 3 ] || die "disable takes 1 to 3 arguments"
        svc_ok "$1"
        [ "$#" -lt 2 ] || [ -z "$2" ] || domain_ok "$2"
        [ "$#" -lt 3 ] || [ "$3" = remove ] || die "the third argument of disable can only be 'remove'"
        exec /bin/bash "$SCRIPTS/disable.sh" "$@" ;;
    start)
        [ "$#" -eq 1 ] || die "start takes 1 argument"
        svc_ok "$1"
        exec /bin/systemctl start "$1" ;;
    status)
        [ "$#" -eq 1 ] || die "status takes 1 argument"
        svc_ok "$1"
        exec /bin/bash "$SCRIPTS/status.sh" "$1" ;;
    logs)
        [ "$#" -eq 2 ] || die "logs takes 2 arguments"
        svc_ok "$1"
        [[ "$2" =~ ^[0-9]{1,5}$ ]] || die "the line count must be a number"
        exec /bin/bash "$SCRIPTS/logs.sh" "$1" "$2" ;;
    monitor)
        [ "$#" -eq 1 ] || die "monitor takes 1 argument"
        svc_ok "$1"
        exec /bin/bash "$SCRIPTS/monitor.sh" "$1" ;;
    *)
        die "unknown action" ;;
esac
