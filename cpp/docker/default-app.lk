# LOOK — Docker imajı varsayılan uygulaması.
# `docker run -p 7400:7400 codlook/look` bunu servis eder (kutudan çalışır).
# KENDİ uygulamanı çalıştırmak için /app'i mount et:  docker run -v ./app:/app codlook/look
route("GET", "/", fn() => response::json([
    "ok" => true,
    "mesaj" => "Merhaba LOOK! Kendi uygulamanız için /app'i mount edin.",
    "docs" => "https://github.com/codlook/look"
]))

# /health — HEALTHCHECK bunu bekler (Dockerfile). 200 dönmeli.
route("GET", "/health", fn() => response::json(["status" => "ok"]))

route("404", fn() => response::error(404, "Bulunamadı"))
