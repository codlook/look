# assoc_sweep — assoc (string-keyed array) read hot-path micro-benchmark.
#
# Motivation: reading a STRING-keyed assoc such as $row["name"] allocated one std::string
# per lookup key in the VM/interpreter (key.to_string()). The str_ref() fast path
# removes that allocation for STRING keys. This harness measures it (before/after, best-of-3).
#
# K = number of keys in the assoc; each round does K reads; TOTAL is held ~constant so
# the measurement captures per-lookup cost independent of K (small K = fast path dominates).
#
# Usage:  lk assoc_sweep.lk            (VM — single engine; the tree-walk interpreter was removed)
use date

const { TOTAL = 5000000 }   # total lookups for each K (~5M)

# Key prefix: must be ABOVE the MSVC small-string optimization threshold (15 bytes) so
# to_string() really allocates on the heap (a short key fits in SSO, no allocation →
# the fast path cannot be measured). In the real world assoc keys can look like this:
# "customer_email_address", "created_at_timestamp", etc.
const { KEY_PREFIX = "customer_record_field_" }

# build an assoc with K keys
function build($k) {
    $a = []
    for ($i = 0; $i < $k; $i = $i + 1) {
        $a[KEY_PREFIX . $i] = $i
    }
    return $a
}

# Fixed key list (read the same keys in a loop each round)
function keys_of($k) {
    $ks = []
    for ($i = 0; $i < $k; $i = $i + 1) {
        $ks = array::push($ks, KEY_PREFIX . $i)
    }
    return $ks
}

use array

# Single run: TOTAL lookups, sum the result (guards against dead-code elimination)
function run_once($a, $ks, $k) {
    $rounds = TOTAL / $k
    $sum = 0
    for ($r = 0; $r < $rounds; $r = $r + 1) {
        for ($j = 0; $j < $k; $j = $j + 1) {
            $sum = $sum + $a[$ks[$j]]
        }
    }
    return $sum
}

function bench_k($k) {
    $a = build($k)
    $ks = keys_of($k)
    # best-of-3
    $best = -1
    $s = 0
    for ($t = 0; $t < 3; $t = $t + 1) {
        $t0 = date::mono_us()
        $s = run_once($a, $ks, $k)
        $t1 = date::mono_us()
        $ms = ($t1 - $t0) / 1000
        if ($best < 0 || $ms < $best) { $best = $ms }
    }
    print("K=" . $k . "  best=" . $best . "ms  (checksum " . $s . ")")
}

bench_k(5)
bench_k(15)
bench_k(50)
bench_k(100)
