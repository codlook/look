# caching_sha2_password (the DEFAULT plugin of MySQL 8) — CI roundtrip + auth proof.
#
# This program runs against a SINGLE mysql:8 service (GitHub Actions service container).
# Goal: to PROVE that the caching_sha2_password auth path (without TLS on localhost = first the RSA/cleartext
# FULL path, because the cache is empty on a fresh server) runs against a REAL server —
# the source did not change, only the coverage in the non-CI shell guard was moved
# to CI.
#
# Output contract (fail-loud, EXPECTED-pin):
#   correct credentials -> "AUTH_OK|<version>|<utf8-value>"
#   wrong password      -> "AUTH_REJECT" (POSITIVE CONTROL — auth really verifies)
# The runner .sh pins both lines to fixed values.

$dsn  = env("MYDSN", "")
$user = env("MYUSER", "")
$host = env("MYHOST", "127.0.0.1")
$port = env("MYPORT", "3306")
$db   = env("MYDB", "testdb")

# ── 1) CORRECT credentials: full roundtrip with a caching_sha2 user ────────────────────
# Fresh server + no TLS => AuthMoreData 0x04 (FULL path) is triggered: an RSA public key
# request (0x02) + an RSA-OAEP encrypted password. After the cache fills, the 2nd connection
# uses the FAST path (0x03); both connections are exercised here.
try {
  $c = db::connect($dsn)
  db::exec($c, "CREATE TABLE IF NOT EXISTS look_csha2_ci (id INT PRIMARY KEY AUTO_INCREMENT, ad VARCHAR(64)) CHARACTER SET utf8mb4")
  db::exec($c, "DELETE FROM look_csha2_ci")
  # Literal value (NOT prepared-bind) — this test isolates the AUTH path; the bind coverage is
  # in a separate test (db_bind_mysql). A caching_sha2 failure must not be confused with a bind failure.
  db::exec($c, "INSERT INTO look_csha2_ci (ad) VALUES ('şğü-caching')")
  $v = db::query($c, "SELECT VERSION() AS v")

  # 2nd connection — the server cache is now full => FAST path (0x03). A separate code branch;
  # the first connection verifies the RSA/FULL path, this one the FAST path.
  $c2 = db::connect($dsn)
  $r  = db::query($c2, "SELECT ad FROM look_csha2_ci")

  print("AUTH_OK|" . $v[0].v . "|" . $r[0].ad)
} catch ($e) {
  print("AUTH_FAIL|" . $e)
}

# ── 2) POSITIVE CONTROL: WRONG password => the connection MUST BE REJECTED ────────────────────
# Proves that the auth path really verifies. If we also connect with the wrong password
# the scramble/RSA step is BEING SKIPPED (the test would be vacuous).
$bad = "mysql://" . $user . ":yanlis_sifre_zzz@" . $host . ":" . $port . "/" . $db
try {
  $bc = db::connect($bad)
  db::query($bc, "SELECT 1")
  print("AUTH_REJECT_FAIL|wrong password was ACCEPTED (auth does not verify)")
} catch ($e) {
  print("AUTH_REJECT")
}
