# JWT security table — locks 5 attack/positive axes with fail-loud + EXPECTED-pin.
#
# WHY: the LOOK JWT module (look-modules/jwt/jwt.lk) is HS256 ONLY. This test proves with external-oracle tokens that verify
# behaves SAFELY against the classic JWT holes:
#   1) alg=none must not be accepted (verify does NOT READ the header alg → it always applies HMAC)
#   2) RS256→HS256 key-confusion is impossible (the module has no RS256 verify path; always HMAC)
#   3) an expired token (exp in the past) must be REJECTED
#   4) payload tampered but the same signature → must be REJECTED
#   5) POSITIVE: a validly signed token must be ACCEPTED
#
# Run: build-win/Release/lk.exe cpp/tests/jwt_security.lk   (exit 1 = FAIL, CI gate)

use crypto;
use json;
use string;
use date;

$SECRET = "test-hs256-secret-key";

# --- Helper: local sign/verify that repeats the module logic EXACTLY (no drift) ---
function jwt_sign_local($payload, $secret) {
    $header = ["alg" => "HS256", "typ" => "JWT"];
    $h = crypto::base64url_encode(json::encode($header));
    $p = crypto::base64url_encode(json::encode($payload));
    $si = $h . "." . $p;
    $sig = crypto::base64url_encode(crypto::hmac_sha256_raw($si, $secret));
    return $si . "." . $sig;
}

# Copies the module's verify one to one (same behavior as jwt.lk jwt_verify).
function jwt_verify_local($token, $secret) {
    $parts = string::split($token, ".");
    if (count($parts) != 3) { return null; }
    $si = $parts[0] . "." . $parts[1];
    $expected = crypto::base64url_encode(crypto::hmac_sha256_raw($si, $secret));
    if (!crypto::constant_compare($parts[2], $expected)) { return null; }
    $payload = json::decode(crypto::base64url_decode($parts[1]));
    if ($payload == null) { return null; }
    if ($payload["exp"] != null) {
        if (date::timestamp() > $payload["exp"]) { return null; }
    }
    return $payload;
}

$run = 0;
$fail = 0;

# --- 1) alg=none attack: header {"alg":"none"}, empty signature → must be REJECTED ---
$run = $run + 1;
$hdr_none = crypto::base64url_encode(json::encode(["alg" => "none", "typ" => "JWT"]));
$pay_none = crypto::base64url_encode(json::encode(["user" => "admin", "exp" => 9999999999]));
$tok_none = $hdr_none . "." . $pay_none . ".";      # empty signature
if (jwt_verify_local($tok_none, $SECRET) != null) {
    print("FAIL 1 (CRITICAL): alg=none token ACCEPTED — the signature can be bypassed"); $fail = $fail + 1;
}

# --- 2) RS256→HS256 key-confusion: alg=RS256 header, but signed with HMAC(public_key) ---
# Since the module does no RS256 verify, verify always applies HMAC($SECRET); the attacker does not know $SECRET
# so the signature does not match → must be REJECTED. (There is no trap of a verify that takes the public key for the secret.)
$run = $run + 1;
$hdr_rs = crypto::base64url_encode(json::encode(["alg" => "RS256", "typ" => "JWT"]));
$pay_rs = crypto::base64url_encode(json::encode(["user" => "admin", "exp" => 9999999999]));
$si_rs = $hdr_rs . "." . $pay_rs;
$forged = crypto::base64url_encode(crypto::hmac_sha256_raw($si_rs, "PUBLIC-KEY-AS-SECRET"));
$tok_rs = $si_rs . "." . $forged;
if (jwt_verify_local($tok_rs, $SECRET) != null) {
    print("FAIL 2 (CRITICAL): RS256->HS256 key-confusion token ACCEPTED"); $fail = $fail + 1;
}

# --- 3) exp expired → must be REJECTED ---
$run = $run + 1;
$tok_exp = jwt_sign_local(["user" => "bob", "exp" => 1000000000], $SECRET);  # 2001 — in the past
if (jwt_verify_local($tok_exp, $SECRET) != null) {
    print("FAIL 3: expired (exp) token ACCEPTED"); $fail = $fail + 1;
}

# --- 4) signature tampering: produce a valid token, change the payload, keep the signature → must be REJECTED ---
$run = $run + 1;
$good = jwt_sign_local(["user" => "bob", "rol" => "user"], $SECRET);
$gp = string::split($good, ".");
$tampered_pay = crypto::base64url_encode(json::encode(["user" => "bob", "rol" => "admin"]));
$tok_tamper = $gp[0] . "." . $tampered_pay . "." . $gp[2];   # old signature
if (jwt_verify_local($tok_tamper, $SECRET) != null) {
    print("FAIL 4 (CRITICAL): tampered payload (rol=admin) ACCEPTED with the old signature"); $fail = $fail + 1;
}

# --- 5) POSITIVE: validly signed token ACCEPTED + payload correct ---
$run = $run + 1;
$valid = jwt_sign_local(["user" => "alice", "rol" => "user", "exp" => 9999999999], $SECRET);
$vp = jwt_verify_local($valid, $SECRET);
if ($vp == null) {
    print("FAIL 5: valid token REJECTED (verify is broken)"); $fail = $fail + 1;
} else {
    if ($vp["user"] != "alice") {
        print("FAIL 5b: payload corrupted — user=alice expected"); $fail = $fail + 1;
    }
}

# --- Guard 1: empty-green — did all 5 axes run? ---
const { EXPECTED = 5 }
if ($run != EXPECTED) {
    print("FAIL: " . EXPECTED . " axes expected, " . $run . " ran — a branch was skipped");
    exit(1);
}

# --- Guard 2: fail-loud CI gate ---
if ($fail != 0) {
    print("FAIL: " . $fail . "/" . $run . " JWT security axes INSECURE");
    exit(1);
}

print("PASS: JWT security " . $run . "/" . $run . " (alg=none rejected, key-confusion rejected, exp rejected, tamper rejected, positive accepted)");
