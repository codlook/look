# PG-TLS matrix 2/4: the server cert is from an UNTRUSTED CA (not in the client trust store).
# verify is the CORRECT DEFAULT (postgresqls://) → the certificate cannot be verified → REJECTED.
# (Run without setting SSL_CERT_FILE → our CA is not on the system.)
try {
  $db = db::connect("postgresqls://looktest:testpass@look-pg/testdb")
  db::query($db, "SELECT 1")
  print("HATA: guvenilmeyen cert KABUL edildi — verify calismiyor")
} catch($e) {
  print("OK reddedildi (guvenilmeyen cert): " . $e)
}
