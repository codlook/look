# ?tls=verify → certificate+hostname verification. Since mysql:8 uses a self-signed cert
# THIS CONNECTION MUST BE REJECTED (certificate verify failed). Being rejected = proof that verify is ACTIVE.
# (With a trusted CA-signed cert tls=verify would ACCEPT; rejecting the self-signed one = MITM protection.)
try {
  $db = db::connect("mysql://looktest:testpass@look-mysql8/testdb?tls=verify")
  db::query($db, "SELECT 1")
  print("HATA: self-signed KABUL edildi — verify calismiyor")
} catch($e) {
  print("OK verify aktif (self-signed reddedildi): " . $e)
}
