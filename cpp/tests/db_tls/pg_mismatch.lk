# PG-TLS matrix 4/4: valid CA-signed cert BUT wrong host (connect by IP, SAN=look-pg).
# Even though the CA is trusted via SSL_CERT_FILE, the hostname (SSL_set1_host) does not match → REJECTED.
# The host argument comes from outside: db::connect takes the DSN from the PG_MISMATCH_DSN env var
$dsn = env("PG_MISMATCH_DSN")
try {
  $db = db::connect($dsn)
  db::query($db, "SELECT 1")
  print("ERROR: hostname mismatch was ACCEPTED — SSL_set1_host is not working")
} catch($e) {
  print("OK rejected (hostname mismatch): " . $e)
}
