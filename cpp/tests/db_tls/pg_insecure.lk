# PG-TLS positive control: ?tls=insecure → encrypted but NOT VERIFIED.
# It connects DESPITE the untrusted cert (verify off) → proves that the rejection in 2/4
# comes from verify, not from a broken handshake.
$db = db::connect("postgresqls://looktest:testpass@look-pg/testdb?tls=insecure")
print(db::query($db, "SELECT 42 AS n")[0]["n"])
