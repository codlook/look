# DB-TLS: mysqls:// / ?tls=1 → SSLRequest + SSL_connect + auth over TLS.
# Ssl_cipher must be FILLED (proof that TLS is active). Connect: mysql://user:pass@host/db?tls=1
$db = db::connect("mysql://looktest:testpass@look-mysql8/testdb?tls=1")
print(db::query($db, "SHOW STATUS LIKE 'Ssl_cipher'")[0]["Value"])
