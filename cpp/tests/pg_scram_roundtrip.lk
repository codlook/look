# PG SCRAM-SHA-256 live auth roundtrip — connects to a real PostgreSQL (pg_hba scram-sha-256).
# The SCRAM handshake goes through look::pbkdf2/hmac/sha256 (unified); if the password is WRONG
# or crypto silently breaks, auth FAILS (connection rejected) → this script prints no result.
$db = db::connect("postgres://looktest_scram:testpass_scram_2026@127.0.0.1/looktestdb_scram")
print(db::query($db, "SELECT 4242 AS n")[0]["n"])
