# Template render GOLDEN corpus. Prints the output of a wide matrix of template constructs;
# tests/template_golden_test.sh compares it byte for byte with template_golden.expected,
# which was generated by the engine as released in build abb5e2e (before the parse cache
# and the render rewrite). A speed measurement says nothing about correctness — this does.
# Escaping in particular must never change: XSS protection depends on it.
# Needs TEMPLATE_DIR + LOOK_FILE_ROOT + BT_DIR (the runner supplies them).
#
# NAMING RULE: no LOOK variable in scope may share a name with a template variable. LOOK
# interpolates `{$x}` in every string literal when $x is in scope, so `{$u.name}` with a LOOK
# variable $u would be substituted BEFORE the template engine sees it and this file would test
# string interpolation instead of the engine. Hence the LOOK-side names $du / $dd.
# Each section is a small function: one large function would exceed what the VM can compile.
use template
use file

function show($label, $out) { print("### " . $label . "\n" . $out) }
$dd = env("BT_DIR")

$du = ["name" => "Ada <b>&\"'`", "role" => "admin", "age" => 30, "score" => 2.5,
      "active" => true, "off" => false, "none" => null, "zero" => 0, "blank" => "",
      "tags" => ["x", "y&z", "<i>"], "empty" => [],
      "deep" => ["a" => ["b" => "bottom"]], "list" => [["k" => "v1"], ["k" => "v2"]]]

function g_vars($du) {
show("var escaped",     template::render_string(`{$u.name}`, ["u" => $du]))
show("var raw",         template::render_string(`{!$u.name}`, ["u" => $du]))
show("deep path",       template::render_string(`{$u.deep.a.b}`, ["u" => $du]))
show("numeric index",   template::render_string(`{$u.tags.0}|{$u.tags.2}|{$u.tags.9}`, ["u" => $du]))
show("list of assoc",   template::render_string(`{$u.list.1.k}`, ["u" => $du]))
show("missing",         template::render_string(`[{$nope}][{$u.nope}][{$u.deep.x.y}]`, ["u" => $du]))
show("scalar types",    template::render_string(`{$u.age}|{$u.score}|{$u.active}|{$u.off}|{$u.none}|{$u.zero}|{$u.blank}`, ["u" => $du]))
show("unicode",         template::render_string(`{$s} çğıöşü İ`, ["s" => "Şeker <ç>"]))
show("literal braces",  template::render_string(`a { b } {c} {$x} }{`, ["x" => "X"]))

}

function g_conds($du) {
show("truthy",          template::render_string(`{#if $u.active}T{#else}F{/if}{#if $u.off}T{#else}F{/if}{#if $u.none}T{#else}F{/if}{#if $u.zero}T{#else}F{/if}{#if $u.blank}T{#else}F{/if}{#if $u.empty}T{#else}F{/if}{#if $u.tags}T{#else}F{/if}{#if $nope}T{#else}F{/if}`, ["u" => $du]))
show("negation",        template::render_string(`{#if !$u.active}T{#else}F{/if}{#if !$u.zero}T{#else}F{/if}{#if !$nope}T{#else}F{/if}`, ["u" => $du]))
show("compare number",  template::render_string(`{#if $u.age > 18}a{/if}{#if $u.age >= 30}b{/if}{#if $u.age < 30}c{/if}{#if $u.age <= 30}d{/if}{#if $u.age == 30}e{/if}{#if $u.age != 30}f{/if}{#if $u.score > 2}g{/if}`, ["u" => $du]))
show("compare string",  template::render_string(`{#if $u.role == "admin"}A{#else}-{/if}{#if $u.role != "admin"}B{#else}-{/if}{#if $u.role == "user"}C{#else}-{/if}`, ["u" => $du]))
show("compare vars",    template::render_string(`{#if $a == $b}eq{#else}ne{/if}{#if $a > $c}gt{#else}le{/if}`, ["a" => 5, "b" => 5, "c" => 9]))
show("if without else", template::render_string(`[{#if $u.off}hidden{/if}]`, ["u" => $du]))
show("nested if",       template::render_string(`{#if $u.active}{#if $u.age > 40}old{#else}young{/if}{#else}off{/if}`, ["u" => $du]))

}

function g_loops($du) {
show("each list",       template::render_string(`{#each $u.tags as $t}[{$t}]{#empty}none{/each}`, ["u" => $du]))
show("each empty",      template::render_string(`{#each $u.empty as $t}[{$t}]{#empty}none{/each}`, ["u" => $du]))
show("each missing",    template::render_string(`{#each $nope as $t}[{$t}]{#empty}none{/each}`, ["u" => $du]))
show("each no-empty",   template::render_string(`<{#each $u.empty as $t}[{$t}]{/each}>`, ["u" => $du]))
show("each assoc",      template::render_string(`{#each $m as $v}({$v}){/each}`, ["m" => ["a" => 1, "b" => "two", "c" => "<3>"]]))
show("each of assoc",   template::render_string(`{#each $u.list as $row}{$row.k};{/each}`, ["u" => $du]))
show("nested each",     template::render_string(`{#each $rows as $r}{#each $r.cells as $c}{$r.id}{$c},{/each}|{/each}`, ["rows" => [["id" => "A", "cells" => [1, 2]], ["id" => "B", "cells" => [3]]]]))
show("each + if",       template::render_string(`{#each $ns as $n}{#if $n > 1}{$n}+{#else}{$n}-{/if}{/each}`, ["ns" => [1, 2, 3]]))
show("loop var scope",  template::render_string(`{$t}:{#each $u.tags as $t}{$t}{/each}:{$t}`, ["u" => $du, "t" => "outer"]))
show("outer in loop",   template::render_string(`{#each $u.tags as $t}{$u.role}-{$t};{/each}`, ["u" => $du]))

}

function g_files_write($dd) {
file::put($dd . "/g_nav.html",    `<nav>{$u.role}/{$extra}</nav>`)
file::put($dd . "/g_card.html",   `<card>{$k}|{$u.role}|{$extra}</card>`)
file::put($dd . "/g_base.html",   `<html>{#include "g_nav"}<h>{#block "head"}default-head{/block}</h><m>{#block "main"}default-main{/block}</m>{$extra}</html>`)
file::put($dd . "/g_child.html",  `{#extends "g_base"}{#block "main"}main:{$extra}{#each $u.list as $row}{#include "g_card" data=$row}{/each}{/block}`)
file::put($dd . "/g_child2.html", `
{#extends "g_base"}
{#block "head"}H2{/block}
{#block "main"}M2{/block}
ignored text outside blocks`)
file::put($dd . "/g_plain.html",  `plain {$extra} {#include "g_nav"}`)
file::put($dd . "/g_loopinc.html", `{#each $u.tags as $t}{#include "g_tag"}{/each}`)
file::put($dd . "/g_tag.html",    `<t>{$t}|{$u.role}</t>`)

}

function g_files_render($du) {
$ctx = ["u" => $du, "extra" => "E&x"]
show("include inherit",        template::render("g_plain", $ctx))
show("extends + data include", template::render("g_child", $ctx))
show("extends two blocks",     template::render("g_child2", $ctx))
show("base rendered directly", template::render("g_base", $ctx))
show("include sees loop var",  template::render("g_loopinc", $ctx))
show("render_string include",  template::render_string(`[{#include "g_nav"}]`, $ctx))
show("render_string extends",  template::render_string(`{#extends "g_base"}{#block "head"}RS{/block}`, $ctx))
show("same file twice",        template::render("g_plain", $ctx) . "|" . template::render("g_plain", ["u" => $du, "extra" => "2nd"]))

}

function g_errors($du, $dd) {
$ctx = ["u" => $du, "extra" => "E&x"]
$e = "NO-ERROR"
try { template::render("g_does_not_exist", $ctx) } catch ($err) { $e = "error" }
show("missing file", $e)
file::put($dd . "/g_badinc.html", `x{#include "g_nope"}y`)
$e = "NO-ERROR"
try { template::render("g_badinc", $ctx) } catch ($err) { $e = "error" }
show("missing include", $e)

show("escape() builtin", template::escape("<a href=\"x\">&'`</a>"))
}

g_vars($du)
g_conds($du)
g_loops($du)
g_files_write($dd)
g_files_render($du)
g_errors($du, $dd)
print("### END")
