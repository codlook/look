# np1: the parallel task captures a CLOSURE ($reader), and that closure holds a mutable cell $c.
# FIX (transitive deep-clone): the task sees an isolated cell → 0. BUG (cell-only): shared → race.
function race(){
  $c = 0
  $reader = fn() => $c
  $ch = channel(1)
  parallel(function(){ send($ch, $reader()) })
  $c = 999
  return receive($ch)
}
print(race())
