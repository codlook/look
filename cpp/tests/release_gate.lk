# release_gate.lk — paketlenen HER binary'ye karsi calistir.
# Amac: artefaktin guvenlik+dogruluk fix'lerini gercekten icerdigini KANITLAMAK.
# Kullanim: ./lk release_gate.lk   (cikis 0 = yayinlanabilir)
# NOT: paketten CIKARILDI (Faz D #4) — repo'da durur, artefakt dogrulamasinda
#      "zip'i ac, REPODAKI bu dosyayi cikarilan lk ile kos" akisiyla kullanilir.
use string
use json
use html
use math
$FAIL = 0
function chk($ad, $gecti) {
  if ($gecti) { print("  OK   " . $ad) } else { print("  FAIL " . $ad) }
}

print("LOOK yayin kapisi")

# --- MSVC 8c63c28: -1 * INT64_MIN cokmemeli (Windows'ta ayrisir) ---
$m = 0
try { $m = -1 * -9223372036854775808 } catch ($e) { $m = -1 }
chk("MSVC carpma-tasma (SIGFPE yok)", $m == 9223372036854775808)

# --- B-05: sayisal olmayan string + sayi fail-loud ---
$b5 = false
try { $x = "abc" + 1 } catch ($e) { $b5 = true }
chk("B-05 aritmetik fail-loud", $b5)

# --- B-08: backtick kacisi (html_escape) ---
chk("B-08 backtick escape", html::escape("`") == "&#96;")

# --- B-04: JSON yinelenen anahtar son-kazanir + konum korunur ---
chk("B-04 JSON son-kazanir", json::encode(json::decode("{\"a\":1,\"b\":2,\"a\":3}")) == "{\"a\":3,\"b\":2}")

# --- F-01: ReDoS slot sizintisi (tasinabilir: yalniz unpatched-Linux imzasi FAIL) ---
$s = string::repeat("a", 44) . "b"
$limit = 0
$timeout = 0
for ($i = 0; $i < 12; $i = $i + 1) {
  try { string::regex_match($s, "(a+)+$") }
  catch ($e) {
    if (string::contains("" . $e, "limit")) { $limit = $limit + 1 }
    else { if (string::contains("" . $e, "timeout")) { $timeout = $timeout + 1 } }
  }
}
chk("F-01 ReDoS slot sizintisi kapali", $limit > 0 || $timeout == 0)

# ── Bu turun DB fix'leri (SQLite ile test edilebilir; canli DB gerekmez) ──
$c = db::connect("sqlite://:memory:")

# S1 c44fc73: db:: GERCEK native prepared binding (escape yerine). Backtick tanimlayici
# icindeki '?' eski escape lehce-parser'inda mismatch/patlama yapardi; native'de SQLite
# kendi sayar. Bu tek assert native-binding'i kanitlar (escape yolu burada patlardi).
$nb = false
try { db::query($c, "SELECT 1 AS `soru?isareti` WHERE 1 = ?", [1]); $nb = true } catch ($e) { }
chk("S1 native prepared binding (backtick)", $nb)

# 973e21e: non-finite float (Inf) bind fail-loud — sqlite/pg sessizce null yapardi (Cephe 2).
$nf = false
try { db::query($c, "SELECT ? AS v", [math::pow(10, 400)]) } catch ($e) { $nf = true }
chk("non-finite bind fail-loud", $nf)

# 9a58962: float round-trip tam (look_format_double birlestirmesi; eski %f 6-hane yuvarlardi).
db::query($c, "CREATE TABLE g (f REAL)", [])
db::exec($c, "INSERT INTO g VALUES (?)", [3.141592653589793])
$gr = db::query($c, "SELECT f FROM g", [])
$fv = "" . $gr[0]["f"]
chk("float round-trip tam", $fv == "3.141592653589793")

print("kapi tamamlandi")
