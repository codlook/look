# release_gate.lk — run against EVERY packaged binary.
# Goal: to PROVE that the artifact really contains the security+correctness fixes.
# Usage: ./lk release_gate.lk   (exit 0 = releasable, exit 1 = a fix is missing)
# NOTE: REMOVED from the package (Phase D #4) — it stays in the repo, and for artifact verification it is used with
#      the flow "unzip, run THIS file from the repo with the extracted lk".
use string
use json
use html
use math

# FAIL-LOUD but ALL failures visible: chk() RETURNS 0 (passed) / 1 (failed), accumulated at the
# call site ($FAIL = $FAIL + chk(...)), a single exit(1) at the end. In LOOK a function cannot INCREMENT a global counter
# (explicit > implicit scope; measured: bump()->0) — so the return-value pattern is the solution that fits the language
# (same as crypto_vectors.lk: one structure per concept). Exit-on-first-failure
# would be WRONG: "which fixes are missing" would degrade to "which is the first missing one" (a step back at the gate).
function chk($name, $passed) {
  if ($passed) { print("  OK   " . $name); return 0 }
  print("  FAIL " . $name)
  return 1
}

$FAIL = 0

print("LOOK release gate")

# --- MSVC 8c63c28: -1 * INT64_MIN must not crash (diverges on Windows) ---
# Since 2026-11-08 integer overflow is an EXPLICIT ERROR (it used to turn into float): the process must stay alive
# and give a catchable "Integer overflow" error — no SIGFPE / crash.
$m = "no-error"
try { $m = -1 * -9223372036854775808 } catch ($e) { $m = "caught" }
$FAIL = $FAIL + chk("MSVC multiply overflow (no SIGFPE, catchable overflow error)", $m == "caught")

# --- B-05: non-numeric string + number fail-loud ---
$b5 = false
try { $x = "abc" + 1 } catch ($e) { $b5 = true }
$FAIL = $FAIL + chk("B-05 arithmetic fail-loud", $b5)

# --- B-08: backtick escaping (html_escape) ---
$FAIL = $FAIL + chk("B-08 backtick escape", html::escape("`") == "&#96;")

# --- http:: codec round: did the string::decode builtin make it into the artifact (an addition of this release).
#     A LOOK string literal cannot carry a raw high byte (no \x) -> the codec TABLE cannot be
#     tested offline; but EXISTENCE is tested: in an old/unpatched binary the function is MISSING -> "no function
#     'decode'" throw -> catch -> false -> FAIL (drift is caught). The ASCII identity path is also verified. ---
$dec_present = false
try { $dv = string::decode("hello", "windows-1254"); $dec_present = ($dv == "hello") } catch ($e) { }
$FAIL = $FAIL + chk("string::decode builtin present (charset codec shipped)", $dec_present)

# --- B-04: JSON duplicate key last-wins + position preserved ---
$FAIL = $FAIL + chk("B-04 JSON last-wins", json::encode(json::decode("{\"a\":1,\"b\":2,\"a\":3}")) == "{\"a\":3,\"b\":2}")

# --- F-01: ReDoS slot leak (portable: only the unpatched-Linux signature FAILs) ---
$s = string::repeat("a", 44) . "b"
$limit = 0
$timeout = 0
for ($i = 0; $i < 12; $i = $i + 1) {
  try { string::regex_match($s, "(a+)+$") }
  catch ($e) {
    if (string::contains("" . $e, "limit")) { $limit = $limit + 1 }
    else { if (string::contains("" . $e, "timeout")) { $timeout = $timeout + 1 } }
  }
}
$FAIL = $FAIL + chk("F-01 ReDoS slot leak closed", $limit > 0 || $timeout == 0)

# ── DB fixes of this round (testable with SQLite; no live DB needed) ──
$c = db::connect("sqlite://:memory:")

# S1 c44fc73: db:: REAL native prepared binding (instead of escaping). A '?' inside a backtick identifier
# would cause a mismatch/blow-up in the old escape-based lenient parser; in native, SQLite
# counts by itself. This single assert proves native binding (the escape path would blow up here).
$nb = false
try { db::query($c, "SELECT 1 AS `soru?isareti` WHERE 1 = ?", [1]); $nb = true } catch ($e) { }
$FAIL = $FAIL + chk("S1 native prepared binding (backtick)", $nb)

# 973e21e: non-finite float (Inf) bind fail-loud. DISCRIMINATING: not "did it throw" but "is it the RIGHT
# error" — the old binary in escape mode embeds to_string(inf) as a bare token and sqlite
# THROWs "no such column: Infinity" (passes for the wrong reason). Our error is "...cannot be bound" -> look for that.
# (Positive control: this line was verified to FAIL on an unpatched binary.)
$nfmsg = ""
try { db::query($c, "SELECT ? AS v", [math::pow(10, 400)]) } catch ($e) { $nfmsg = "" . $e }
$FAIL = $FAIL + chk("non-finite bind fail-loud", string::contains($nfmsg, "cannot bind"))

# NOTE: the "float round-trip" assertion was REMOVED — it was not discriminating in SQLite (the old path was also correct with
# %.17g -> it would pass on an unpatched binary too = a fake assertion, lesson t1). What really got fixed was the
# PG/MySQL BIND; that cannot be tested at the gate (live DB) -> do not give false confidence, trust the STAMP.

print("")
if ($FAIL > 0) {
  print("FAIL: " . $FAIL . " checks failed — not releasable")
  exit(1)
}
print("gate complete")
