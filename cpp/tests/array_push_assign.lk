# `$a = array::push($a, v)` is compiled as an in-place append (as push($a, v)): the array grows in
# its own storage instead of being copied on every call (100k appends: ~60 s before, well under 1 s
# after). Every result and error below must stay exactly what the copying version gave.
#
# The rewrite rests on one property of the language: while the value is computed, $a cannot change.
# - A function cannot change the caller's local variable (there is no `global`, no reference
#   parameter, and a closure captures by value). Pinned below — if the language ever gains a way,
#   this test fails and the rewrite in compiler.cpp (try_compile_push_assign) must be revisited.
# - A top-level (global) variable CAN be changed by a function, so for globals the rewrite is only
#   used when the value contains no call; the results below pin the old order there too.
use array
use string
struct P { x any }

$fails = 0
function check($name, $got, $want) {
  if (json::encode($got) != json::encode($want)) {
    print("FAIL " . $name . ": got " . json::encode($got) . ", want " . json::encode($want))
    return 1
  }
  return 0
}

# value semantics: another variable sharing the array is not changed
function alias() { $a = [1, 2]; $b = $a; $a = array::push($a, 3); return [$a, $b] }
$fails = $fails + check("alias", alias(), [[1, 2, 3], [1, 2]])

# appending the array to itself appends the OLD array
function self_append() { $a = [1, 2]; $a = array::push($a, $a); $a = array::push($a, $a); return $a }
$fails = $fails + check("self append", self_append(), [1, 2, [1, 2], [1, 2, [1, 2]]])
$g = [7]
$g = array::push($g, $g)
$fails = $fails + check("self append (global)", $g, [7, [7]])

# the value changes $a itself: assignment / core push inside the argument (old order kept)
function assign_in_arg() { $a = [1]; $a = array::push($a, $a = [9]); return $a }
$fails = $fails + check("assignment in the value", assign_in_arg(), [1, [9]])
function push_in_arg() { $a = [1]; $a = array::push($a, push($a, 7)); return $a }
$fails = $fails + check("push() in the value", push_in_arg(), [1, 2])

# the common case: the value comes from calls
function fmt($r) { return "#" . $r["id"] }
function rows() {
  $a = []
  foreach ([["id" => 1], ["id" => 2]] as $row) { $a = array::push($a, ["id" => $row["id"], "ad" => fmt($row)]) }
  $a = array::push($a, string::upper("x"))
  $a = array::push($a, array::push($a, 3))
  return $a
}
$fails = $fails + check("values from calls", rows(),
  [["id" => 1, "ad" => "#1"], ["id" => 2, "ad" => "#2"], "X",
   [["id" => 1, "ad" => "#1"], ["id" => 2, "ad" => "#2"], "X", 3]])

# PINNED: a function cannot change the caller's local $a (same name, own variable)
function changer() { $a = [42]; push($a, 1); $a[0] = 0; return 5 }
function caller() {
  $a = [1]
  $f = fn() => array::push($a, 9)   # a closure gets a copy of $a as it is now: [1]
  $a = array::push($a, changer())
  $a = array::push($a, count($f()))
  return $a
}
$fails = $fails + check("function cannot change the caller's local", caller(), [1, 5, 2])

# a function CAN change a top-level variable: the old order is kept (value computed after the read)
$t = [1]
function bump() { push($t, 99); return 5 }
$t = array::push($t, bump())
$fails = $fails + check("function changes the global during the value", $t, [1, 5])

# an error in the value leaves $a as it was
function bad() { throw "boom" }
function throws() { $a = [1]; try { $a = array::push($a, bad()) } catch ($e) { } return $a }
$fails = $fails + check("value throws", throws(), [1])

# error messages are those of array::push
function nonarray() { $a = 5; $a = array::push($a, 1) }
$m = ""
try { nonarray() } catch ($e) { $m = "" . $e }
$fails = $fails + check("not an array", $m, "array::push() requires array and value")
function onstruct() { $a = P { x: 1 }; $a = array::push($a, 1) }
$m = ""
try { onstruct() } catch ($e) { $m = "" . $e }
$fails = $fails + check("struct", $m, "array::push() does not take a struct ('P'): a struct is not an array, use its fields")

# speed: 100k appends took about a minute while every call copied the array
function many($n) { $a = []; for ($i = 0; $i < $n; $i = $i + 1) { $a = array::push($a, "row" . $i) } return count($a) }
$t0 = date::timestamp()
$c = many(100000)
$secs = date::timestamp() - $t0
$fails = $fails + check("100k appends", $c, 100000)
if ($secs > 20) { print("FAIL 100k appends took " . $secs . " s (the array is copied on every append)"); $fails = $fails + 1 }

if ($fails > 0) { exit(1) }
print("PASS: $a = array::push($a, v) appends in place with the same results and errors")
