# LOOK 2 typed struct guard: a field is name + TYPE + default.
#
#   name string          typed, no default -> zero value ("")
#   age  int = 18        typed + default
#   score ?float         nullable
#   profile Profile      another struct (may be null)
#   note any             takes every value
#   (one form only: "name type [= default]"; an untyped field and the v1 "name: default"
#   spelling are parse errors — tests/struct_single_form_test.sh)
#
# One rule set for both engines (include/look/struct_types.h): a value that does not match
# the field type is an error at construction AND on later assignment; an int may go into a
# float field; null only into ?type / any / fn / struct-typed fields; the shape
# is fixed (assigning an undeclared field is an error; v1 silently added it).
# Uses only builtin module functions so the CLI really runs it on the VM.
use json
use array
use template

function chk($label, $got, $want) {
    if ($got == $want) { print("OK   " . $label) }
    else { print("FAIL " . $label . " => got[" . $got . "] want[" . $want . "]") }
}
function err_of($f) {
    $err = "NO-ERROR"
    try { $r = $f(); $err = "NO-ERROR" } catch ($e) { $err = "" . $e }
    return $err
}

struct Profile { bio string }
struct User {
    name string
    age int = 18
    score ?float
    ratio float
    tags array
    meta map
    active bool
    profile Profile
    on_save fn
    extra any
    note any
    role any = "member"
}

# ── zero values and defaults ────────────────────────────────────────────────
$u = User{name: "Ada"}
chk("zero values + defaults", json::encode($u),
    "{\"name\":\"Ada\",\"age\":18,\"score\":null,\"ratio\":0,\"tags\":[],\"meta\":{},\"active\":false,\"profile\":null,\"on_save\":null,\"extra\":null,\"note\":null,\"role\":\"member\"}")
$empty = User{}
chk("empty literal", $empty.name, "")

# ── construction: matching values ───────────────────────────────────────────
$full = User{name: "Bo", age: 30, score: 1.5, ratio: 2, tags: ["a"], active: true,
             profile: Profile{bio: "hi"}, on_save: fn() => 1, extra: [1, 2], note: 7, role: 3}
chk("typed values accepted",   "" . $full.age . $full.profile.bio, "30hi")
chk("int goes into a float field", json::encode($full.ratio * 1.5), "3")
chk("any fields take anything", "" . $full.note . $full.role, "73")

# ── construction: mismatches ────────────────────────────────────────────────
chk("string into int",   err_of(fn() => User{age: "30"}),      "struct 'User': field 'age' expects int, got string")
chk("float into int",    err_of(fn() => User{age: 1.5}),       "struct 'User': field 'age' expects int, got float")
chk("int into string",   err_of(fn() => User{name: 5}),        "struct 'User': field 'name' expects string, got int")
chk("int into bool",     err_of(fn() => User{active: 1}),      "struct 'User': field 'active' expects bool, got int")
chk("map into array",    err_of(fn() => User{tags: ["k" => 1]}), "struct 'User': field 'tags' expects array, got map")
chk("string into ?float", err_of(fn() => User{score: "x"}),    "struct 'User': field 'score' expects ?float, got string")
chk("wrong struct",      err_of(fn() => User{profile: User{}}), "struct 'User': field 'profile' expects Profile, got User")
chk("null into int",     err_of(fn() => User{age: null}),
    "struct 'User': field 'age' expects int, got null (declare it as ?int to allow null)")
chk("null into ?float ok",     err_of(fn() => User{score: null}),   "NO-ERROR")
chk("null into struct field ok", err_of(fn() => User{profile: null}), "NO-ERROR")
chk("unknown field in literal", err_of(fn() => User{nmae: "x"}), "Unknown field 'nmae' in struct 'User'")

# ── assignment after construction ───────────────────────────────────────────
function many_assign_bad() { $x = User{}; $x.age = "old"; return 1 }
function compound_bad()    { $x = User{name: "a"}; $x.name = $x.name == "a" ? 5 : "b"; return 1 }
function shape_bad()       { $x = User{}; $x.nickname = "z"; return 1 }
function index_bad()       { $x = User{}; $x["age"] = true; return 1 }
$u.age = 40
chk("assign matching value", $u.age, 40)
$u.age += 2
chk("compound assign", $u.age, 42)
$u.ratio = 3
chk("assign int into float field", json::encode($u.ratio / 2), "1.5")
chk("assign mismatch",   err_of(fn() => many_assign_bad()),  "struct 'User': field 'age' expects int, got string")
chk("compound mismatch", err_of(fn() => compound_bad()),     "struct 'User': field 'name' expects string, got int")
chk("value kept after a refused assignment", $u.age, 42)
chk("undeclared field",  err_of(fn() => shape_bad()),        "struct 'User' has no field 'nickname'")
chk("index syntax is checked too", err_of(fn() => index_bad()), "struct 'User': field 'age' expects int, got bool")


# ── defaults are checked and never shared between instances ─────────────────
struct Bad { n int = "seven" }
chk("default of the wrong type", err_of(fn() => Bad{}), "struct 'Bad': field 'n' expects int, got string")
chk("...unless overridden?  no: the declaration is wrong", err_of(fn() => Bad{n: 1}),
    "struct 'Bad': field 'n' expects int, got string")

struct Box { items array, labels array = ["x"] }
$a = Box{}
$b = Box{}
$a.items[0] = 1
chk("mutation reaches its own instance", count($a.items), 1)
chk("zero-value array is per instance", count($b.items), 0)
$a.labels[1] = "y"
chk("mutation reaches its own instance (default)", count($a.labels), 2)
$fresh = Box{}
chk("default array is per instance", count($fresh.labels), 1)


# ── value semantics: assigning or passing gives the receiver its own value ──
$orig = Box{}
$orig.items[0] = "kept"
$alias = $orig
$alias.items[0] = "changed"
$taken = $orig.items
$taken[0] = "changed too"
chk("assigning a struct copies it", $orig.items[0] . "/" . $alias.items[0] . "/" . $taken[0], "kept/changed/changed too")

# ── a struct is its own kind of value, not an array ─────────────────────────
struct P1 { name string, x int }
struct P2 { x int, pad int, name string }
function name_of($s) { return $s.name }
function set_x($s, $v) { $s.x = $v; return $s.x }
$p1 = P1{name: "one", x: 1}
$p2 = P2{name: "two", x: 2}
# The same instruction sees two struct types whose fields sit at different positions:
# the per-instruction slot cache must follow the definition, not the last position used.
chk("one call site, two struct types (read)",  name_of($p1) . name_of($p2) . name_of($p1) . name_of($p2), "onetwoonetwo")
chk("one call site, two struct types (write)", "" . set_x($p1, 10) . set_x($p2, 20) . set_x($p1, 11), "102011")
chk("a struct passed to a function is the callee's own value", "" . $p1.x . $p2.x . $p2.name, "12two")
chk("type check still applies on the cached path", err_of(fn() => set_x($p2, "s")), "struct 'P2': field 'x' expects int, got string")
chk("reading an undeclared field is an error", err_of(fn() => $p1.nope), "struct 'P1' has no field 'nope'")
chk("a numeric index is refused", err_of(fn() => $p1[0]), "a struct is not an array: use a field name ('P1' has no numeric index)")
chk("array:: functions refuse a struct", err_of(fn() => array::push($p1, 1)) != "NO-ERROR", true)
chk("field read through index syntax", $p1["name"], "one")
$seen = ""
foreach ($p2 as $k => $v) { $seen = $seen . $k . "=" . $v . ";" }
chk("foreach walks the fields in declaration order", $seen, "x=2;pad=0;name=two;")
chk("json::encode writes an object", json::encode($p1), "{\"name\":\"one\",\"x\":1}")
chk("printing a struct", "" . $p1, "P1{name: one, x: 1}")
chk("template resolves a struct field", template::render_string('{$u.name}/{$u.x}', ["u" => $p1]), "one/1")
struct Outer { inner P1, items array }
$o = Outer{inner: P1{name: "in", x: 5}}
chk("nested struct field", $o.inner.name . $o.inner.x, "in5")

# ── a misspelled type is an error when the struct is first built, value or no value ─────
struct Typo { name strng, n int }
chk("unknown type name", err_of(fn() => Typo{n: 1}),
    "struct 'Typo': field 'name' has unknown type 'strng' (expected int, float, string, bool, array, map, fn, any or the name of a struct)")
struct Later { next Node }
struct Node { v int }
chk("a struct declared later is a known type", err_of(fn() => Later{next: Node{v: 1}}), "NO-ERROR")
print("")
print("=== typed struct guard done ===")
