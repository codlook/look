# finally-on-return behavior — deterministic order. The runner verifies the expected lines in the
# output. BUG (fixed): the VM skipped finally in `try { return X } finally { ... }`
# (the interpreter skipped it in return-inside-catch). Both fixed; this test is the regression guard.

# 1. return-in-try → finally runs, the return value is preserved
function ret_try() { try { return 42 } finally { print("T-FIN") } }
print("1:" . ret_try())

# 2. nested — inside out
function nested() {
  try { try { return "R" } finally { print("N-IC") } } finally { print("N-DIS") }
}
print("2:" . nested())

# 3. return-in-catch → finally runs
function ret_catch() {
  try { throw "x" } catch($e) { return "C" } finally { print("C-FIN") }
}
print("3:" . ret_catch())

# 4. normal path (no return) → finally ONCE
function normal() { try { print("NORMAL-TRY") } finally { print("NORMAL-FIN") } }
normal()

# 5. caught throw → finally
function thrown() { try { throw "e" } catch($e) { print("CATCH") } finally { print("THROW-FIN") } }
thrown()

# 6. break out of try-finally → the in-loop finally runs
$i = 0
while ($i < 3) {
  try {
    if ($i == 1) { break }
    print("B-ITER " . $i)
  } finally {
    print("B-FIN " . $i)
  }
  $i = $i + 1
}

# 7. continue out of try-finally → finally runs
$j = 0
while ($j < 3) {
  $j = $j + 1
  try {
    if ($j == 2) { continue }
    print("K-ITER " . $j)
  } finally {
    print("K-FIN " . $j)
  }
}

# 8. uncaught throw (no catch) → finally runs, then propagates
function unc() { try { throw "boom" } finally { print("U-FIN") } }
try { unc() } catch($e) { print("U-CATCH:" . $e) }

# 9. throw INSIDE finally → REPLACES the original exception (Java/JS semantics)
function fit() { try { throw "ORIG" } finally { throw "FINT" } }
try { fit() } catch($e) { print("FIT:" . $e) }

