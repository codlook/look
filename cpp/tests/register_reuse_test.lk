function closures_in_args() {
    $base = 10
    $s = 0
    $s = $s + add3(one(fn($x) => $x + $base)(1), 0, 0)
    $s = $s + add3(one(fn($x) => $x + $base)(2), 0, 0)
    $s = $s + add3(one(fn($x) => $x + $base)(3), 0, 0)
