# Register reuse guard (2026-10-01).
#
# Every call with arguments used to consume ~argc+1 registers for good: the argument
# block was always taken from the top and "protected" by raising a watermark that never
# came back down, which also discarded every temporary allocated before it. One function
# could hold at most 72 route() calls or 63 three-argument calls; past that the compile
# failed and the WHOLE program ran on the interpreter (CLI and web).
#
# Each function below is far past the old ceiling. Under LOOK_VM_STRICT=1 a compile
# failure is an error, so this file only runs at all if the registers are reused; the
# sums check that reuse did not corrupt a live value.
# Uses only builtin module functions so the CLI really runs it on the VM.
use json

function chk($label, $got, $want) {
    if ($got == $want) { print("OK   " . $label) }
    else { print("FAIL " . $label . " => got[" . $got . "] want[" . $want . "]") }
}

function add3($a, $b, $c) { return $a + $b + $c }
function one($a) { return $a }
function pair($a, $b) { return [$a, $b] }

