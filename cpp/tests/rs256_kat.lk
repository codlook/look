# RS256 (RSASSA-PKCS#1 v1.5 + SHA-256) known-answer testi.
#
# NEDEN SABİT İMZA, sign→verify DEĞİL: sign→verify→true SAHTE-YEŞİL üretir — aynı yığın
# kendini doğrular, ikisi birden yanlışsa yine eşleşir. Burada beklenen imza DIŞ ORACLE ile
# üretildi (`openssl dgst -sha256 -sign`, PKCS#1 v1.5 DETERMİNİSTİK olduğu için sabit) ve
# LOOK'un çıktısı ona pinlenir. Ayrıca REDDETME tarafı da test edilir (bozuk mesaj/imza →
# false); yoksa "verify çalışıyor" hükmü verilemez.
#
# Platform notu (olgunluk denetimi Tema B): POSIX yolu (OpenSSL) burada TAM doğrulanır.
# Windows rs256_verify şu an STUB (`throw`) — dürüst başarısızlık, güvenli. Bu KAT, bir
# Windows CI geldiğinde NCrypt impl'ini AYNI sabit imzaya karşı doğrulayacak SİLAHTIR.
#
# ⚠️ TEST KEY ONLY — NEVER USE IN PRODUCTION. 2048-bit (küçük anahtar bazı OpenSSL
#    yapılandırmalarında reddedilir → sahte-kırmızı; 2048 güvenli taban).
#   Çalıştır: build/lk cpp/tests/rs256_kat.lk   (exit 1 = FAIL, CI gate)

use crypto

# PEM'ler base64-of-PEM olarak tek satır embed (newline/tırnak sorunu sıfır; çalışma-anında decode).
$pub  = crypto::base64_decode("")
# ⚠️ TEST KEY ONLY — NEVER USE IN PRODUCTION
$priv = crypto::base64_decode("")

$msg = "LOOK rs256 KAT vector v1"
# Dış oracle imzası (openssl dgst -sha256 -sign, deterministik):
$sig = crypto::base64_decode("")

$SIG_B64 = ""

$run = 0
$fail = 0

# 1) POZİTİF (dış-oracle imzası kabul edilmeli). SIGN değil — sabit imza.
$run = $run + 1
if (crypto::rs256_verify($msg, $sig, $pub) != true) {
    print("FAIL 1: gecerli dis-oracle imzasi REDDEDILDI (verify kirik)"); $fail = $fail + 1
}

# 2) REDDET: bozuk mesaj → false
$run = $run + 1
if (crypto::rs256_verify("DEGISTIRILMIS mesaj", $sig, $pub) != false) {
    print("FAIL 2: bozuk mesaj KABUL edildi (verify her seye true donuyor)"); $fail = $fail + 1
}

# 3) REDDET: yanlis imza (baska mesajin gecerli imzasi) → false
$run = $run + 1
$wrong = crypto::rs256_sign("baska bir mesaj", $priv)
if (crypto::rs256_verify($msg, $wrong, $pub) != false) {
    print("FAIL 3: yanlis imza KABUL edildi"); $fail = $fail + 1
}

# 4) SIGN deterministik: rs256_sign cikitisi dis-oracle imzasina birebir eslesmeli
$run = $run + 1
if (crypto::base64_encode(crypto::rs256_sign($msg, $priv)) != $SIG_B64) {
    print("FAIL 4: rs256_sign dis-oracle imzasindan SAPTI (PKCS#1 v1.5 determinizmi bozuk)"); $fail = $fail + 1
}

# Guard 1 — empty-green: 4 kontrol koştu mu (bir dal atlanmadi)?
const { EXPECTED = 4 }
if ($run != EXPECTED) {
    print("FAIL: " . EXPECTED . " kontrol beklendi, " . $run . " kostu — bir dal atlandi")
    exit(1)
}

# Guard 2 — fail-loud: CI gate.
if ($fail != 0) {
    print("FAIL: " . $fail . "/" . $run . " rs256 KAT kontrolu basarisiz")
    exit(1)
}

print("PASS: rs256 KAT " . $run . "/" . $run . " (verify+reject+sign, dis-oracle openssl'e pinli)")
