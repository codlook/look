# date:: DST regression test — is the add/sub/diff day arithmetic CALENDAR-based (DST-safe).
#
# BUG (maturity audit 2026-08-11, sibling-path heuristic): add/sub "day" used 86400 seconds,
# diff "day" used (mktime-mktime)/86400 → DST fall-back (a 25h day) shifted +1 day onto the SAME day,
# spring-forward (a 23h day) made diff come out 1 short. A silent 1-day class
# (subscription/reservation/reminder). Fix: day/week are calendar-based (tm_mday / civil-day); hour/min/sec
# stay real-time seconds.
#
# IMPORTANT: it must run under a TZ with DST (US 2024: spring 03-10, fall 11-03). CI:
#   TZ=America/New_York build/lk cpp/tests/date_dst_test.lk
# It runs in UTC too (no DST → it was already correct; the regression is locked on both axes).

use date

$run = 0
$fail = 0

# add: +1 day onto the fall-back day (25h) → the next calendar day (86400s gave the SAME day)
$run = $run + 1
if (date::add("2024-11-03", 1, "day") != "2024-11-04") {
    print("FAIL add: 11-03 +1gun != 11-04 (DST fall-back kaymasi) -> " . date::add("2024-11-03", 1, "day")); $fail = $fail + 1
}
# add: 2 days that SPAN the 25h day
$run = $run + 1
if (date::add("2024-11-02", 2, "day") != "2024-11-04") {
    print("FAIL add: 11-02 +2gun != 11-04 -> " . date::add("2024-11-02", 2, "day")); $fail = $fail + 1
}
# add week
$run = $run + 1
if (date::add("2024-11-01", 1, "week") != "2024-11-08") {
    print("FAIL add: 11-01 +1hafta != 11-08 -> " . date::add("2024-11-01", 1, "week")); $fail = $fail + 1
}
# sub day
$run = $run + 1
if (date::sub("2024-11-04", 1, "day") != "2024-11-03") {
    print("FAIL sub: 11-04 -1gun != 11-03 -> " . date::sub("2024-11-04", 1, "day")); $fail = $fail + 1
}
# diff: 3 days spanning spring-forward (23h) (the 86400 path gave 2)
$run = $run + 1
if (date::diff("2024-03-12", "2024-03-09", "day") != 3) {
    print("FAIL diff: 03-12..03-09 != 3 (spring-forward budama) -> " . date::diff("2024-03-12", "2024-03-09", "day")); $fail = $fail + 1
}
# diff: 3 days spanning fall-back
$run = $run + 1
if (date::diff("2024-11-04", "2024-11-01", "day") != 3) {
    print("FAIL diff: 11-04..11-01 != 3 -> " . date::diff("2024-11-04", "2024-11-01", "day")); $fail = $fail + 1
}
# hour: the REAL-time path is not broken (DST-correct seconds)
$run = $run + 1
if (date::diff("2024-06-15 14:00:00", "2024-06-15 12:00:00", "hour") != 2) {
    print("FAIL diff hour: 2-hour difference is wrong -> " . date::diff("2024-06-15 14:00:00", "2024-06-15 12:00:00", "hour")); $fail = $fail + 1
}

# Guard 1 — empty-green: did 7 checks run?
const { EXPECTED = 7 }
if ($run != EXPECTED) {
    print("FAIL: " . EXPECTED . " checks expected, " . $run . " ran — a branch was skipped")
    exit(1)
}
# Guard 2 — fail-loud.
if ($fail != 0) {
    print("FAIL: " . $fail . "/" . $run . " date DST checks failed")
    exit(1)
}
print("PASS: date DST " . $run . "/" . $run . " (add/sub/diff are calendar-based, DST-safe)")
