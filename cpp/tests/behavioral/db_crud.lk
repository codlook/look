# db:: davranışsal test — gömülü SQLite (sunucu YOK). CI-koşabilir.
# CRUD + tx commit/rollback + transaction() closure hata→otomatik rollback.
$ran = 0
function chk($l, $g, $w) {
    if ($g == $w) { print("OK   " . $l) }
    else { print("FAIL " . $l . "  got[" . $g . "] want[" . $w . "]") }
}

$c = db::connect("sqlite://:memory:")
db::exec($c, "CREATE TABLE u (id INTEGER PRIMARY KEY, ad TEXT)", [])

# CREATE
db::exec($c, "INSERT INTO u (ad) VALUES (?)", ["ali"])
chk("C last_id>0", db::last_id($c) > 0, true); $ran = $ran + 1
chk("C affected", db::exec($c, "INSERT INTO u (ad) VALUES (?)", ["veli"]), 1); $ran = $ran + 1
# READ
chk("R count", len(db::query($c, "SELECT * FROM u", [])), 2); $ran = $ran + 1
# UPDATE
chk("U affected", db::exec($c, "UPDATE u SET ad=? WHERE ad=?", ["ALI", "ali"]), 1); $ran = $ran + 1
# DELETE
chk("D affected", db::exec($c, "DELETE FROM u WHERE ad=?", ["veli"]), 1); $ran = $ran + 1
chk("D kalan", len(db::query($c, "SELECT * FROM u", [])), 1); $ran = $ran + 1

# TX commit kalıcı
db::begin($c); db::exec($c, "INSERT INTO u (ad) VALUES ('tx1')", []); db::commit($c)
chk("TX commit kalici", len(db::query($c, "SELECT * FROM u WHERE ad='tx1'", [])), 1); $ran = $ran + 1
# TX rollback geri alır
db::begin($c); db::exec($c, "INSERT INTO u (ad) VALUES ('tx2')", []); db::rollback($c)
chk("TX rollback geri", len(db::query($c, "SELECT * FROM u WHERE ad='tx2'", [])), 0); $ran = $ran + 1
# transaction() closure + hata → otomatik rollback
try {
    db::transaction($c, function() use ($c) {
        db::exec($c, "INSERT INTO u (ad) VALUES ('t3')", [])
        throw "boom"
    })
} catch ($e) { }
chk("TX fn hata→rollback", len(db::query($c, "SELECT * FROM u WHERE ad='t3'", [])), 0); $ran = $ran + 1

const { EXPECTED = 9 }
if ($ran != EXPECTED) { print("FAIL harness: " . $ran . " assert kostu, " . EXPECTED . " bekleniyordu") }
print("=== db ran=" . $ran . " ===")
