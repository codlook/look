# prepared statements (native) — PostgreSQL extended-query (Parse/Bind/Execute/Sync) bind
# matrix. A REAL postgres:16 server is REQUIRED (CI service container; DSN = PG_DSN env).
# TYPE PARITY with the SQLite bind matrix (db_bind_sqlite.lk): int64 boundary · negative int64 ·
# float · bool · UTF-8/special characters · real NULL · injection (bind escape) · param-count
# rejection. The `?`→`$1` conversion + text-format param encoding (NULL = length -1) is verified
# live here. fail-loud + empty-green.
$ran = 0
function chk($l, $g, $w) {
    if ($g == $w) { print("OK   " . $l) }
    else { print("FAIL " . $l . "  got[" . $g . "] want[" . $w . "]") }
}

$dsn = env("PG_DSN", "")
# If the environment is missing: FAIL in CI, SKIP locally (see db_bind_mysql.lk — same contract).
if ($dsn == "") {
    if (env("CI", "") == "true") { print("FAIL harness: PG_DSN is empty in CI — the postgres:16 service or its DSN is misconfigured"); print("=== bind ran=0 ==="); exit(1) }
    print("SKIP: PG_DSN not set — needs a live postgres:16 server (CI provides one)"); exit(0)
}
$c = db::connect($dsn)

db::exec($c, "DROP TABLE IF EXISTS bindp", [])
db::exec($c, "CREATE TABLE bindp (i BIGINT, ni BIGINT, f DOUBLE PRECISION, b BOOLEAN, s TEXT, n TEXT)", [])
# ALL columns use parameterized bind (NOT literal interpolation — positive control: the injection line).
db::exec($c, "INSERT INTO bindp (i,ni,f,b,s,n) VALUES (?,?,?,?,?,?)",
    [9223372036854775807, -9223372036854775807, 3.141592653589793, true, "o'zel \" karakter \\ 日本 son", null])
$r = db::query($c, "SELECT i,ni,f,b,s,n FROM bindp", [])[0]

# int64 BOUNDARY (2^63-1) — above 2^53; the double-promotion bug (look-int64-karsilastirma-double)
# would have corrupted this integer. text-format param + BIGINT parse must carry it bit-exact.
chk("int64 limit 2^63-1", "" . db::col($r, "i"), "9223372036854775807"); $ran = $ran + 1
chk("int64 negatif buyuk", "" . db::col($r, "ni"), "-9223372036854775807"); $ran = $ran + 1
chk("float/ondalik round-trip", "" . db::col($r, "f"), "3.141592653589793"); $ran = $ran + 1
$bv = "" . db::col($r, "b")
chk("bool", ($bv == "1" || $bv == "true" || $bv == "t"), true); $ran = $ran + 1
chk("utf8+special-char", db::col($r, "s"), "o'zel \" karakter \\ 日本 son"); $ran = $ran + 1
chk("null gercek-null", db::col($r, "n") == null, true); $ran = $ran + 1

# POSITIVE CONTROL — parameterized bind ≠ string interpolation. If the param were embedded in the SQL,
# the `' OR '1'='1` tautology would return ALL rows; bind searches for a literal match, so 0.
chk("injection tautoloji→0", len(db::query($c, "SELECT * FROM bindp WHERE s=?", ["' OR '1'='1"])), 0); $ran = $ran + 1

# POSITIVE CONTROL — a payload with SQL metacharacters is stored as DATA and comes back verbatim.
$payload = "'); DROP TABLE bindp;--"
db::exec($c, "INSERT INTO bindp (s) VALUES (?)", [$payload])
$q = db::query($c, "SELECT s FROM bindp WHERE s=?", [$payload])
chk("metacharacter payload as data", len($q), 1); $ran = $ran + 1
chk("metakarakter payload aynen", db::col($q[0], "s"), $payload); $ran = $ran + 1
# the table still exists (DROP did not run) — the injection really is ineffective
chk("table still alive (injection had no effect)", len(db::query($c, "SELECT i FROM bindp", []) ) >= 1, true); $ran = $ran + 1

# param-count rejection (2 placeholders, 1 param) — the server must REJECT in the Bind message
$caught = false
try { db::query($c, "SELECT * FROM bindp WHERE i=? AND s=?", [1]) } catch ($e) { $caught = true }
chk("param-sayim reddi", $caught, true); $ran = $ran + 1

# ── constraint fail-loud (UNIQUE + NOT NULL) — PG was already correct (ErrorResponse 'E'),
# but it is now locked by MEASUREMENT (a test, not a source reading). Same contract on all three drivers. ──
db::exec($c, "DROP TABLE IF EXISTS ctp", [])
db::exec($c, "CREATE TABLE ctp (id INT PRIMARY KEY, email VARCHAR(80) UNIQUE, name VARCHAR(80) NOT NULL)", [])
db::exec($c, "INSERT INTO ctp (id,email,name) VALUES (?,?,?)", [1, "a@x", "Ali"])
$uq = false
try { db::exec($c, "INSERT INTO ctp (id,email,name) VALUES (?,?,?)", [2, "a@x", "Vel"]) } catch ($e) { $uq = true }
chk("UNIQUE fail-loud", $uq, true); $ran = $ran + 1
$cc = db::query($c, "SELECT COUNT(*) AS c FROM ctp", [])[0]
chk("UNIQUE row rejected (count==1)", "" . db::col($cc, "c"), "1"); $ran = $ran + 1
$nn = false
try { db::exec($c, "INSERT INTO ctp (id,email,name) VALUES (?,?,?)", [3, "b@x", null]) } catch ($e) { $nn = true }
chk("NOT NULL fail-loud", $nn, true); $ran = $ran + 1

const { EXPECTED = 14 }
if ($ran != EXPECTED) { print("FAIL harness: " . $ran . " asserts ran, " . EXPECTED . " expected") }
print("=== bind ran=" . $ran . " ===")
