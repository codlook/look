# validator:: input-validation behavioral test — security boundary (pure). Runnable in CI.
# Rule contract (extra_stdlib.cpp make_validator): required, email, integer,
# numeric, min:N, max:N, in:a,b,c. Result is ["ok"=>bool, "errors"=>assoc].
# IMPORTANT: str_is_integer/numeric are STRICT — "123abc" / "5; DROP" MUST BE REJECTED
# (the stoi leading-parse bypass is closed). POSITIVE CONTROL: flip one want → FAIL.
use validator
$ran = 0
function chk($l, $g, $w) { if ($g == $w) { print("OK   " . $l) } else { print("FAIL " . $l . "  got[" . $g . "] want[" . $w . "]") } }

# Helper: take the "ok" bool from the validator::check result
function vok($data, $rules) { $r = validator::check($data, $rules); return $r["ok"] }

# ── email ──
chk("email valid", vok(["e" => "a@b.com"], ["e" => ["email"]]), true); $ran = $ran + 1
chk("email no-dot", vok(["e" => "a@b"], ["e" => ["email"]]), false); $ran = $ran + 1
chk("email no-at", vok(["e" => "ab.com"], ["e" => ["email"]]), false); $ran = $ran + 1
chk("email bosluk", vok(["e" => "a b@c.com"], ["e" => ["email"]]), false); $ran = $ran + 1

# ── required ── (an empty value must be rejected)
chk("required empty", vok(["n" => ""], ["n" => ["required"]]), false); $ran = $ran + 1
chk("required filled", vok(["n" => "x"], ["n" => ["required"]]), true); $ran = $ran + 1
# a missing field must not pass required either (get_field returns empty)
chk("required missing-field", vok([], ["n" => ["required"]]), false); $ran = $ran + 1

# ── integer (STRICT — bypass closed) ──
chk("integer temiz", vok(["a" => "42"], ["a" => ["integer"]]), true); $ran = $ran + 1
chk("integer negatif", vok(["a" => "-7"], ["a" => ["integer"]]), true); $ran = $ran + 1
# SECURITY: "123abc" must NOT count as an integer (there must be no stoi leading-parse bypass)
chk("integer coplu-RED", vok(["a" => "123abc"], ["a" => ["integer"]]), false); $ran = $ran + 1
# SECURITY: a SQL-injection tail must not leak into integer
chk("integer sqli-RED", vok(["a" => "5; DROP TABLE t"], ["a" => ["integer"]]), false); $ran = $ran + 1

# ── numeric ──
chk("numeric ondalik", vok(["a" => "3.14"], ["a" => ["numeric"]]), true); $ran = $ran + 1
chk("numeric coplu-RED", vok(["a" => "3.14xx"], ["a" => ["numeric"]]), false); $ran = $ran + 1

# ── min / max (numeric value bound) ──
chk("min valid", vok(["y" => "18"], ["y" => ["min:18"]]), true); $ran = $ran + 1
chk("min ihlal", vok(["y" => "17"], ["y" => ["min:18"]]), false); $ran = $ran + 1
chk("max valid", vok(["y" => "99"], ["y" => ["max:100"]]), true); $ran = $ran + 1
chk("max ihlal", vok(["y" => "101"], ["y" => ["max:100"]]), false); $ran = $ran + 1

# ── in: (whitelist) ──
chk("in valid", vok(["r" => "admin"], ["r" => ["in:admin,user"]]), true); $ran = $ran + 1
chk("in disinda", vok(["r" => "root"], ["r" => ["in:admin,user"]]), false); $ran = $ran + 1

# ── combined rules + error message surface ──
chk("required+email zincir", vok(["e" => ""], ["e" => ["required", "email"]]), false); $ran = $ran + 1
# many fields: if one is wrong, the overall ok=false
chk("multi-field one-invalid",
    vok(["e" => "a@b.com", "y" => "abc"],
        ["e" => ["email"], "y" => ["integer"]]), false); $ran = $ran + 1
# all valid → ok=true
chk("multi-field all-ok",
    vok(["e" => "a@b.com", "y" => "30"],
        ["e" => ["email"], "y" => ["integer"]]), true); $ran = $ran + 1

const { EXPECTED = 22 }
if ($ran != EXPECTED) { print("FAIL harness: " . $ran . " != " . EXPECTED) }
print("=== validator ran=" . $ran . " ===")
