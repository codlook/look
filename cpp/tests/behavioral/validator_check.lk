# validator:: girdi-doğrulama davranışsal testi — güvenlik sınırı (saf). CI-koşabilir.
# Kural sözleşmesi (extra_stdlib.cpp make_validator): required, email, integer,
# numeric, min:N, max:N, in:a,b,c. Sonuç ["ok"=>bool, "errors"=>assoc].
# ÖNEMLİ: str_is_integer/numeric KATI'dır — "123abc" / "5; DROP" REDDEDİLMELİ
# (stoi baştan-alma bypass'ı kapalı). POZİTİF KONTROL: bir want'ı ters çevir → FAIL.
use validator
$ran = 0
function chk($l, $g, $w) { if ($g == $w) { print("OK   " . $l) } else { print("FAIL " . $l . "  got[" . $g . "] want[" . $w . "]") } }

# Yardımcı: validator::check sonucundan "ok" bool'unu al
function vok($data, $rules) { $r = validator::check($data, $rules); return $r["ok"] }

# ── email ──
chk("email gecerli", vok(["e" => "a@b.com"], ["e" => ["email"]]), true); $ran = $ran + 1
chk("email nokta-yok", vok(["e" => "a@b"], ["e" => ["email"]]), false); $ran = $ran + 1
chk("email at-yok", vok(["e" => "ab.com"], ["e" => ["email"]]), false); $ran = $ran + 1
chk("email bosluk", vok(["e" => "a b@c.com"], ["e" => ["email"]]), false); $ran = $ran + 1

# ── required ── (boş değer reddedilmeli)
chk("required bos", vok(["n" => ""], ["n" => ["required"]]), false); $ran = $ran + 1
chk("required dolu", vok(["n" => "x"], ["n" => ["required"]]), true); $ran = $ran + 1
# eksik alan da required'ı geçmemeli (get_field boş döner)
chk("required eksik-alan", vok([], ["n" => ["required"]]), false); $ran = $ran + 1

# ── integer (KATI — bypass kapalı) ──
chk("integer temiz", vok(["a" => "42"], ["a" => ["integer"]]), true); $ran = $ran + 1
chk("integer negatif", vok(["a" => "-7"], ["a" => ["integer"]]), true); $ran = $ran + 1
# GÜVENLİK: "123abc" tam-sayı SAYILMAMALI (stoi baştan-alma bypass'ı olmamalı)
chk("integer coplu-RED", vok(["a" => "123abc"], ["a" => ["integer"]]), false); $ran = $ran + 1
# GÜVENLİK: SQL-injection kuyruğu integer'a sızmamalı
chk("integer sqli-RED", vok(["a" => "5; DROP TABLE t"], ["a" => ["integer"]]), false); $ran = $ran + 1

# ── numeric ──
chk("numeric ondalik", vok(["a" => "3.14"], ["a" => ["numeric"]]), true); $ran = $ran + 1
chk("numeric coplu-RED", vok(["a" => "3.14xx"], ["a" => ["numeric"]]), false); $ran = $ran + 1

# ── min / max (sayısal değer sınırı) ──
chk("min gecerli", vok(["y" => "18"], ["y" => ["min:18"]]), true); $ran = $ran + 1
chk("min ihlal", vok(["y" => "17"], ["y" => ["min:18"]]), false); $ran = $ran + 1
chk("max gecerli", vok(["y" => "99"], ["y" => ["max:100"]]), true); $ran = $ran + 1
chk("max ihlal", vok(["y" => "101"], ["y" => ["max:100"]]), false); $ran = $ran + 1

# ── in: (whitelist) ──
chk("in gecerli", vok(["r" => "admin"], ["r" => ["in:admin,user"]]), true); $ran = $ran + 1
chk("in disinda", vok(["r" => "root"], ["r" => ["in:admin,user"]]), false); $ran = $ran + 1

# ── kombine kural + hata mesajı yüzeyi ──
chk("required+email zincir", vok(["e" => ""], ["e" => ["required", "email"]]), false); $ran = $ran + 1
# çok alan: biri hatalıysa toplam ok=false
chk("cok-alan biri-hatali",
    vok(["e" => "a@b.com", "y" => "abc"],
        ["e" => ["email"], "y" => ["integer"]]), false); $ran = $ran + 1
# hepsi geçerli → ok=true
chk("cok-alan hepsi-ok",
    vok(["e" => "a@b.com", "y" => "30"],
        ["e" => ["email"], "y" => ["integer"]]), true); $ran = $ran + 1

const { EXPECTED = 22 }
if ($ran != EXPECTED) { print("FAIL harness: " . $ran . " != " . EXPECTED) }
print("=== validator ran=" . $ran . " ===")
