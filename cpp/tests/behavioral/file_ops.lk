# file:: behavioral test — local FS (NO server). Runnable in CI. LOOK_FILE_ROOT + BT_DIR come from the runner.
# put/read/append/exists/remove/size + traversal-guard rejection. The path should be absolute (inside the root).
use file
# If the environment is missing: FAIL in CI, SKIP locally (see db_bind_mysql.lk). Normally behavioral_test.sh
# provides LOOK_FILE_ROOT+BT_DIR; this check only covers direct runs.
if (env("BT_DIR", "") == "" || env("LOOK_FILE_ROOT", "") == "") {
    if (env("CI", "") == "true") { print("FAIL harness: BT_DIR / LOOK_FILE_ROOT are empty in CI"); exit(1) }
    print("SKIP: BT_DIR / LOOK_FILE_ROOT not set — run it through tests/behavioral_test.sh"); exit(0)
}
$ran = 0
function chk($l, $g, $w) { if ($g == $w) { print("OK   " . $l) } else { print("FAIL " . $l . "  got[" . $g . "] want[" . $w . "]") } }

$f = env("BT_DIR") . "/bt_file.txt"
chk("exists missing", file::exists($f), false); $ran = $ran + 1
chk("put", file::put($f, "hello"), true); $ran = $ran + 1
chk("exists var", file::exists($f), true); $ran = $ran + 1
chk("read", file::read($f), "hello"); $ran = $ran + 1
chk("size", file::size($f), 5); $ran = $ran + 1
chk("append", file::append($f, " world"), true); $ran = $ran + 1
chk("read append", file::read($f), "hello world"); $ran = $ran + 1
chk("size append", file::size($f), 11); $ran = $ran + 1
file::put($f, "çğ")
chk("size unicode-byte", file::size($f), 4); $ran = $ran + 1
chk("remove", file::remove($f), true); $ran = $ran + 1
chk("exists deleted", file::exists($f), false); $ran = $ran + 1
# access OUTSIDE the root must be rejected (traversal guard)
$denied = false
try { file::read("../../etc/passwd") } catch($e) { $denied = true }
chk("traversal reddedildi", $denied, true); $ran = $ran + 1

const { EXPECTED = 12 }
if ($ran != EXPECTED) { print("FAIL harness: " . $ran . " != " . EXPECTED) }
print("=== file ran=" . $ran . " ===")
