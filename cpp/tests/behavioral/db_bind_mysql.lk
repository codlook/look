# prepared statements (native) — MySQL COM_STMT_PREPARE + COM_STMT_EXECUTE bind matrisi.
# GERÇEK mysql:8 sunucusu ŞART (CI servis-container'ı; DSN = MYSQL_DSN env). SQLite bind
# matrisiyle (db_bind_sqlite.lk) TİP-PARİTE: int64 sınır · negatif int64 · float · bool ·
# UTF-8/özel-karakter · gerçek-NULL · injection(bind escape) · param-sayısı reddi.
# Binary protokol yolu (LONGLONG/DOUBLE/lenenc-string/NULL-bitmap) burada canlı doğrulanır —
# seam-testleri (mysql_reassemble) wire-birleştirmeyi kapsar; bu, ELDE-KODLANMIŞ bind
# kodlamasının gerçek sunucuca DOĞRU çözüldüğünü kanıtlar. fail-loud + empty-green.
$ran = 0
function chk($l, $g, $w) {
    if ($g == $w) { print("OK   " . $l) }
    else { print("FAIL " . $l . "  got[" . $g . "] want[" . $w . "]") }
}

$dsn = env("MYSQL_DSN", "")
if ($dsn == "") { print("FAIL harness: MYSQL_DSN bos — canli mysql:8 DSN gerekli"); print("=== bind ran=0 ==="); exit(1) }
$c = db::connect($dsn)

db::exec($c, "DROP TABLE IF EXISTS bindm", [])
db::exec($c, "CREATE TABLE bindm (i BIGINT, ni BIGINT, f DOUBLE, b BOOLEAN, s TEXT, n TEXT)", [])
# TÜM sütunlar parametreli bind (literal-interpolation DEĞİL — pozitif kontrol: injection satırı).
db::exec($c, "INSERT INTO bindm (i,ni,f,b,s,n) VALUES (?,?,?,?,?,?)",
    [9223372036854775807, -9223372036854775807, 3.141592653589793, true, "o'zel \" karakter \\ 日本 son", null])
$r = db::query($c, "SELECT i,ni,f,b,s,n FROM bindm", [])[0]

# int64 SINIR (2^63-1) — 2^53 üstü; double-promosyon bug'ı (look-int64-karsilastirma-double)
# bu tam-sayıyı bozardı. Binary LONGLONG (8-bayt) yolu bit-tam taşımalı.
chk("int64 sinir 2^63-1", "" . db::col($r, "i"), "9223372036854775807"); $ran = $ran + 1
chk("int64 negatif buyuk", "" . db::col($r, "ni"), "-9223372036854775807"); $ran = $ran + 1
chk("float/ondalik round-trip", "" . db::col($r, "f"), "3.141592653589793"); $ran = $ran + 1
$bv = "" . db::col($r, "b")
chk("bool", ($bv == "1" || $bv == "true" || $bv == "t"), true); $ran = $ran + 1
chk("utf8+ozel-karakter", db::col($r, "s"), "o'zel \" karakter \\ 日本 son"); $ran = $ran + 1
chk("null gercek-null", db::col($r, "n") == null, true); $ran = $ran + 1

# POZİTİF KONTROL — parametreli bind ≠ string-interpolation. Eğer param SQL'e gömülseydi
# `' OR '1'='1` tautoloji TÜM satırları döndürürdü; bind literal olarak eşleşme aradığından 0.
chk("injection tautoloji→0", len(db::query($c, "SELECT * FROM bindm WHERE s=?", ["' OR '1'='1"])), 0); $ran = $ran + 1

# POZİTİF KONTROL — SQL-metakarakterli payload VERİ olarak saklanıp aynen geri gelir.
$payload = "'); DROP TABLE bindm;--"
db::exec($c, "INSERT INTO bindm (s) VALUES (?)", [$payload])
$q = db::query($c, "SELECT s FROM bindm WHERE s=?", [$payload])
chk("metakarakter payload veri-olarak", len($q), 1); $ran = $ran + 1
chk("metakarakter payload aynen", db::col($q[0], "s"), $payload); $ran = $ran + 1
# tablo hâlâ var (DROP çalışmadı) — injection gerçekten etkisiz
chk("tablo hayatta (injection etkisiz)", len(db::query($c, "SELECT i FROM bindm", []) ) >= 1, true); $ran = $ran + 1

# param-sayısı reddi (2 placeholder, 1 param) — sunucu/sürücü RED etmeli
$caught = false
try { db::query($c, "SELECT * FROM bindm WHERE i=? AND s=?", [1]) } catch ($e) { $caught = true }
chk("param-sayim reddi", $caught, true); $ran = $ran + 1

# ── constraint fail-loud (UNIQUE + NOT NULL) — db::exec kisit ihlalinde THROW etmeli ──
db::exec($c, "DROP TABLE IF EXISTS ctm", [])
db::exec($c, "CREATE TABLE ctm (id INT PRIMARY KEY, email VARCHAR(80) UNIQUE, name VARCHAR(80) NOT NULL)", [])
db::exec($c, "INSERT INTO ctm (id,email,name) VALUES (?,?,?)", [1, "a@x", "Ali"])
$uq = false
try { db::exec($c, "INSERT INTO ctm (id,email,name) VALUES (?,?,?)", [2, "a@x", "Vel"]) } catch ($e) { $uq = true }
chk("UNIQUE fail-loud", $uq, true); $ran = $ran + 1
$cc = db::query($c, "SELECT COUNT(*) AS c FROM ctm", [])[0]
chk("UNIQUE satir reddedildi (count==1)", "" . db::col($cc, "c"), "1"); $ran = $ran + 1
$nn = false
try { db::exec($c, "INSERT INTO ctm (id,email,name) VALUES (?,?,?)", [3, "b@x", null]) } catch ($e) { $nn = true }
chk("NOT NULL fail-loud", $nn, true); $ran = $ran + 1

# ── binary temporal decode — prepared/binary yolda DATETIME/DATE/TIME/TIMESTAMP ham wire
# baytlari yerine string dönmeli (eskiden default→read_lenenc_str = ham 7/4 bayt; text-protokol
# hep dogruydu, sadece binary yol isirdi → PG etkilenmedi). WHERE tail=? bind'i binary yolu
# zorlar. tail sentinel = CURSOR HIZASI: yanlis bayt tüketimi sonraki sütunu SESSIZCE bozar.
db::exec($c, "DROP TABLE IF EXISTS tmm", [])
db::exec($c, "CREATE TABLE tmm (dt DATETIME NOT NULL, ts TIMESTAMP NOT NULL, dt6 DATETIME(6) NOT NULL, d DATE NOT NULL, t TIME NOT NULL, tail VARCHAR(16) NOT NULL)", [])
db::exec($c, "INSERT INTO tmm (dt,ts,dt6,d,t,tail) VALUES (?,?,?,?,?,?)", ["2026-01-02 13:14:15", "2026-03-04 05:06:07", "2026-07-08 09:10:11.123456", "2026-01-02", "13:14:15", "SENTINEL"])
$tr = db::query($c, "SELECT dt,ts,dt6,d,t,tail FROM tmm WHERE tail=?", ["SENTINEL"])[0]
chk("DATETIME round-trip", db::col($tr, "dt"), "2026-01-02 13:14:15"); $ran = $ran + 1
chk("TIMESTAMP round-trip (0x07 ayri tip)", db::col($tr, "ts"), "2026-03-04 05:06:07"); $ran = $ran + 1
chk("DATETIME(6) mikrosaniye (11-bayt)", db::col($tr, "dt6"), "2026-07-08 09:10:11.123456"); $ran = $ran + 1
chk("DATE round-trip", db::col($tr, "d"), "2026-01-02"); $ran = $ran + 1
chk("TIME round-trip", db::col($tr, "t"), "13:14:15"); $ran = $ran + 1
chk("TAIL sentinel bozulmamis (cursor hizasi)", db::col($tr, "tail"), "SENTINEL"); $ran = $ran + 1

const { EXPECTED = 20 }
if ($ran != EXPECTED) { print("FAIL harness: " . $ran . " assert kostu, " . EXPECTED . " bekleniyordu") }
print("=== bind ran=" . $ran . " ===")
