# B-05 arith_check behavior pinning (regression guard).
# In arithmetic (+,-,*,/,%) a non-numeric operand must not SILENTLY become 0 (fail-loud).
# While == is type-strict ("5"==5 → false), + should be consistent too.
# Run: build/lk tests/repro/arith_coercion.lk
use json
function ok($l, $g, $w)  { if ($g == $w) { print("OK   " . $l) } else { print("FAIL " . $l . " got[" . $g . "] want[" . $w . "]") } }
function thr($l, $fn)    { try { $fn(); print("FAIL " . $l . " (an error was expected, it passed)") } catch ($e) { print("OK   " . $l . " (fail-loud)") } }

# --- VALID: numeric strings and numeric types are preserved ---
ok("\"5\" + 1 = 6",      "5" + 1, 6)
ok("true + 1 = 2",       true + 1, 2)
ok("false + 1 = 1",      false + 1, 1)
ok("2 * 3 = 6",          2 * 3, 6)

# --- FAIL-LOUD: the silent-0 data corruption is closed ---
thr("\"abc\" + 1",       fn() => "abc" + 1)
thr("bignum(str) + 1",   fn() => json::decode("{\"n\":123456789012345678901234567890}")["n"] + 1)
thr("null + 1 (missing key)", fn() => json::decode("{\"a\":1}")["missing"] + 1)
thr("[] + 1",            fn() => [] + 1)
thr("\" 5 \" + 1 (spaces)", fn() => " 5 " + 1)

# --- a string holding a decimal takes part as that number (it was cut to an integer: "2.5" + 1 was 3) ---
ok("\"2.5\" + 1 = 3.5",   "2.5" + 1, 3.5)
ok("\"1e3\" + 1 = 1001",  "1e3" + 1, 1001)
ok("\"1e-400\" + 1 = 1 (nearest value, as Go)", "1e-400" + 1, 1)

# --- only decimal notation: hex, inf and nan are not numbers (they were a silent 0, so + 1 gave 1) ---
thr("\"inf\" + 1",  fn() => "inf" + 1)
thr("\"nan\" + 1",  fn() => "nan" + 1)
thr("\"0x10\" + 1", fn() => "0x10" + 1)
thr("-\"abc\"",     fn() => -"abc")
thr("-null",        fn() => -json::decode("{}")["missing"])
print("=== arith_coercion done ===")
