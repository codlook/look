# t1b — DETERMINISTIK yaris: tum thread'ler AYNI elemana yazar + kapi ile es-anli baslar.
# Orijinal t1 her thread'e AYRI indeks veriyordu ($shared[$i]) -> cakisma tesadufe kaliyordu.
$shared = [0]
$gate = channel(8)
$done = channel(8)
for ($i=0; $i<8; $i=$i+1) {
  parallel(function() use ($shared, $gate, $done) {
    receive($gate)                                   # hepsi burada bekler
    for ($j=0; $j<2000; $j=$j+1) { $shared[0] = $shared[0] + 1 }
    send($done, 1)
  })
}
for ($k=0; $k<8; $k=$k+1) { send($gate, 1) }         # hepsini birlikte serbest birak
for ($k=0; $k<8; $k=$k+1) { receive($done) }
print("T1B bitti")
