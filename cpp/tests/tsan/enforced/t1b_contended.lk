# t1b — DETERMINISTIK: 8 thread AYNI yakalanan diziyle ayni anda baslar ve her biri onu
# kendi degiskenine alip yazar. LOOK 2'de closure DEGERI yakalar ve yakalanana yazamaz
# (yuklemede hata), o yuzden eski "herkes $shared[0]'a yazar" hali artik gecerli kod degil.
# Sinanan sey ayni kaldi: depolamayi paylasan degerlere es-anli ilk yazma (yazinca-kopyala
# ayrilmasi + atomik sayac) yarissiz olmali ve kimse digerinin yazdigini gormemeli.
$shared = [0]
$gate = channel(8)
$done = channel(8)
for ($i=0; $i<8; $i=$i+1) {
  parallel(function() use ($shared, $gate, $done) {
    receive($gate)                                   # hepsi burada bekler
    $mine = $shared
    for ($j=0; $j<2000; $j=$j+1) { $mine[0] = $mine[0] + 1 }
    send($done, $mine[0] * 10 + $shared[0])          # 20000 + 0 bekleniyor
  })
}
for ($k=0; $k<8; $k=$k+1) { send($gate, 1) }         # hepsini birlikte serbest birak
$bad = 0
for ($k=0; $k<8; $k=$k+1) { if (receive($done) != 20000) { $bad = $bad + 1 } }
if ($bad != 0 || $shared[0] != 0) { print("BAD " . $bad); exit(1) }
print("T1B bitti")
