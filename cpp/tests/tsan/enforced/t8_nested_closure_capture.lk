# t8 — does clone_for_thread stop at one level for a NESTED CLOSURE CAPTURE
#
# Zincir: outer.clone_for_thread() -> clone_look_function -> closure->clone()
#         -> Environment::clone() -> $inner.deep_clone() -> FUNCTION -> return *this (SIG)
#         -> $inner's env is shared -> the $big inside it is shared -> RACE
#
# Difference from t6: there `fn() => $big` was created INSIDE the thread; here
# the closure ITSELF is captured (`use ($inner)`).
#
# EXPECTATION (with the current fix): RACES (VM and interpreter)
# EXPECTATION (after Environment::clone_for_thread is added): 0
$big   = [[0]]
$inner = function() use ($big) { return $big }
$gate  = channel(8)
$done  = channel(8)
for ($i=0; $i<8; $i=$i+1) {
  parallel(function() use ($inner, $gate, $done) {
    receive($gate)                                   # start at the same time
    for ($j=0; $j<2000; $j=$j+1) {
      $x = $inner()
      $x[0][0] = $j
    }
    send($done, 1)
  })
}
for ($k=0; $k<8; $k=$k+1) { send($gate, 1) }
for ($k=0; $k<8; $k=$k+1) { receive($done) }
print("T8 bitti")
