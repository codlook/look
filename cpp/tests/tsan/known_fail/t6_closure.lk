# T6: closure capture + kanal uzerinden Value paylasimi (deep_clone yolu)
$done = channel(8)
$big = [[1,2,3],[4,5,6],["a","b"]]
for ($i=0; $i<8; $i=$i+1) {
  parallel(function() use ($done, $big, $i) {
    $r = fn() => $big
    for ($j=0; $j<150; $j=$j+1) { $x = $r(); $x[0][0] = $j }
    send($done, $big)
  })
}
for ($k=0; $k<8; $k=$k+1) { receive($done) }
print("T6 bitti")
