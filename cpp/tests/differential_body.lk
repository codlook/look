use array;
use cache;
use queue;
use template;
use validator;
use type;
use crypto;
use date;
function dif_fib($n) { if ($n < 2) { return $n } return dif_fib($n-1) + dif_fib($n-2) }

# Struct VM parity (2026-09-30): the VM knew nothing about struct definitions → in CLI-VM and web-VM
# defaults were not applied, a literal with unknown fields was silently accepted; no
# test used structs so this category did not exist. Declared at TOP LEVEL: on the web the setup
# runs the VM and the definition is carried into the request's VM via vm_setup_globals (production path).
# `tag: $dif_sd` dynamic default — evaluated at declaration time (like tree-walk).
$dif_sd = "dyn"
struct DifUser {
  name any
  role any = "member"
  tag any = $dif_sd
}
# LOOK typed struct (name + type + default) — the same zero value and the same error on all three engines.
struct DifTyped {
  n int = 1
  s string
  f ?float
  xs array
}

# BODY SPLIT INTO CATEGORY FUNCTIONS (2026-09-30). A single huge run_all() exceeded the VM's 255-register
# limit → CLI AND web handed the WHOLE program SILENTLY to the interpreter; this guard's
# "tree-walk == CLI-VM == web-VM" line was interpreter×3 for the body (with today's compiler
# since ~2026-07-18). Now each piece is far below the limit and the differential_test.sh CLI+web
# columns run only on the VM (there is no other engine in LOOK): if the VM cannot compile, the guard goes RED, it does not pass silently.
# WHEN ADDING A NEW CATEGORY: do not bloat a single dif_pN — open a new dif_pN.
function dif_p1() {
  $o = "";
  # arithmetic + overflow + INT64 edges + division/modulo
  $o .= "A:" . (3+4*2) . "," . (10/3) . "," . (10%3) . "," . (2**10) . "," . (-9999999999) . "," . (7/2) . ";";
  # string + COW aliasing + concat
  $s="ab"; $t=$s; $s.="cd"; $u="x"; $u.=$u; $u.=$u;
  $o .= "B:" . $s . "," . $t . "," . $u . ";";
  # comparison + coercion
  $o .= "C:" . (5==5.0) . "," . ("5"==5) . "," . ("a"<"b") . "," . (0=="") . "," . (1<2) . ";";
  # bitwise/shift
  $o .= "D:" . (12&10) . "," . (12|1) . "," . (12^5) . "," . (1<<4) . "," . (256>>2) . "," . (~5) . ";";
  # array + push/pop + index + nested
  $a=[1,2,3]; $a=array::push($a,4); $last=$a[-1]; $a=array::slice($a,0,-1); $a[0]=99; $n=[[1,2],[3,4]];
  $o .= "E:" . json::encode($a) . "," . $last . "," . $n[1][0] . ";";
  # object + member + index atama
  $m=["name"=>"ali","age"=>30]; $m.age=31; $m["city"]="ist";
  $o .= "F:" . $m.name . "," . $m.age . "," . $m["city"] . ";";
  return $o;
}

function dif_p2() {
  $o = "";
  # higher-order + implicit capture + explicit use + user-fn callback
  $mul=3; $mp=array::map([1,2,3], fn($x)=>$x*$mul);
  $fl=array::filter([1,2,3,4,5], fn($x)=>$x>2);
  $rd=array::reduce([1,2,3,4], fn($ac,$x)=>$ac+$x, 0);
  $base=100; $f=fn($x) use($base) => $base+$x;
  $o .= "G:" . json::encode($mp) . "," . json::encode($fl) . "," . $rd . "," . $f(5) . ";";
  # control flow: while+continue+break, if/else, ternary
  $sum=0; $i=0; while($i<6){ if($i==2){$i=$i+1; continue;} if($i==5){break;} $sum=$sum+$i; $i=$i+1; }
  $o .= "H:" . $sum . "," . (5>3?"y":"n") . ";";
  # string functions + builtin aliases
  $o .= "I:" . len("merhaba") . "," . count([1,2,3]) . "," . intval("42") . "," . strtoupper("abc") . ";";
  # join
  $o .= "J:" . join(["a","b","c"], "-") . ";";
  return $o;
}

function dif_p3() {
  $o = "";
  # try/catch — C++ runtime error (division/mod by zero) + LOOK throw + finally + nested
  # (VM try/catch must also catch operator exceptions — like the interpreter)
  $k=""; try{ $qx=10/0 }catch($e){ $k.="d" }
  try{ $qy=10%0 }catch($e){ $k.="m" }
  try{ throw "boom" }catch($e){ $k.=$e }
  $fin=""; try{ $qz=1/0 }catch($e){ $fin.="c" }finally{ $fin.="f" }
  # throw crossing a function boundary: a throw inside a directly called LOOK fn → the caller's
  # catch must catch it. The VM THROW opcode does frame-pop + goto call_dispatch (a plain break left a stale
  # proto/dangling frame → silent stop, VM≠interpreter; 2026-08-11 fix). The C++ builtin callback
  # path (array::map below, line ~63) is a DIFFERENT axis — this locks the direct-CALL path.
  function _thrower() { throw "xfn" }
  try { _thrower() } catch($e) { $k .= "|" . $e }
  $o .= "K:" . $k . "|" . $fin . ";";
  # string interpolation — '$'-prefixed expression forms (VM==interpreter)
  $ia=5; $ib=3; $iarr=[10,20,30]; $im=["name"=>"ali","age"=>30];
  $o .= "L:{$ia}-{$ia + $ib}-{$iarr[1]}-{$im.name}-{$im.age * 2};";
  # type:: — is_function must also recognize a VM closure (BYTECODE_FN)
  $o .= "M:" . type::is_int(5) . "," . type::is_string("a") . "," . type::is_array([1]) . ","
             . type::is_function(fn($x)=>$x) . "," . type::of(1.5) . "," . type::to_int("42") . ";";
  # crypto:: — the deterministic ones (except random/uuid: the value cannot be compared)
  $o .= "N:" . crypto::base64_encode("merhaba") . "," . crypto::base64_decode("bWVyaGFiYQ==") . ","
             . crypto::hex_encode("ab") . "," . crypto::hmac_sha256("msg","key") . ","
             . crypto::constant_compare("a","b") . ";";
  return $o;
}

function dif_p4() {
  $o = "";
  # exception across the VM↔interpreter bridge: the array::map callback runs in an inner run().
  # throw/runtime-error must reach the OUTER try/catch (try_floor_ + LookVmThrow). Without a base
  # the inner run() jumps to the outer handler → the call stack is corrupted, the C++ catch in between (e.g. db::transaction
  # ROLLBACK) is skipped. The value must also be preserved ("stop" — not e.what()).
  $bo = "";
  try { $bm = array::map([1,2,3], function($x){ if ($x == 2) { throw "stop" } return $x }); $bo .= "no" }
  catch ($e) { $bo .= "caught:" . $e }
  try { $bm2 = array::map([1,0], function($x){ return 10 / $x }); $bo .= "|no" }
  catch ($e) { $bo .= "|rt" }
  $o .= "O:" . $bo . "|" . json::encode(array::map([1,2], function($x){ return $x * 10 })) . ";";
  # Higher-order coverage completion: sort(comparator)/find/any/all — were MISSING from the guard,
  # which is why array::sort's comparator being SILENTLY ignored in the VM slipped through
  # (the callback FUNCTION-only check rejected BYTECODE_FN → default order).
  $o .= "P:" . json::encode(array::sort([3,1,4,1,5], function($a,$b){ return $b - $a })) . ","
             . array::find([1,2,3,4], function($x){ return $x > 2 }) . ","
             . array::any([1,2,3], function($x){ return $x == 9 }) . ","
             . array::all([2,4], function($x){ return $x % 2 == 0 }) . ","
             . json::encode(array::sort([3,1,2])) . ";";
  # error::new TYPED throw — error::new DOES NOT RETURN A VALUE, it throws LookRuntimeError(payload).
  # VM dispatch must preserve the payload (has_value ? value : message); if it is
  # degraded to the e.what() string, error::is() returns false, error::message() gives the whole object → silently
  # wrong error handling. It must also be preserved across the bridge (array::map callback).
  $eo = "";
  try { throw error::new("E_DB", "baglanti yok") }
  catch ($e) { $eo .= error::message($e) . "," . error::is($e, "E_DB") . "," . error::is($e, "E_X") }
  try { $em = array::map([1,2], function($x){ if ($x == 2) { throw error::new("E_MAP", "iki") } return $x }) }
  catch ($e) { $eo .= "|" . error::message($e) . "," . error::is($e, "E_MAP") }
  $o .= "Q:" . $eo . ";";
  # Core language coverage: recursion, nested closures, loop-variable capture, foreach assoc
  $mk = function($base){ return function($x) use ($base) { return $base + $x } }
  $add10 = $mk(10)
  $fns = []; $ri = 0
  while ($ri < 3) { $rv = $ri; $fns = array::push($fns, function() use ($rv) { return $rv * 100 }); $ri = $ri + 1 }
  $rm = ["a"=>1, "b"=>2]; $rs = ""
  foreach ($rm as $rk => $rvv) { $rs .= $rk . $rvv }
  # 3b lock: a use()-captured FOREACH loop-local must NOT RETURN array-wrapped in the VM (["x"] not
  # "x"). json::encode exposes the wrap; in the old bug the VM skipped the CELL [0] deref of the
  # explicit-use() capture → tree-walk "x", VM ["x"] = divergence. Both engines must give "pq".
  $cap = []; foreach (["p","q"] as $cx) { $cap = array::push($cap, function() use ($cx) { return $cx }) }
  $capj = json::encode($cap[0]()) . "-" . json::encode($cap[1]());
  $o .= "R:" . dif_fib(12) . "," . $add10(5) . "," . $fns[0]() . $fns[1]() . $fns[2]() . "," . $rs . "," . $capj . ";";
  return $o;
}

function dif_p5() {
  $o = "";
  # Undefined variable — STRICT (Go/Node band; only the distribution is taken from PHP, not the semantics
  # ). The VM used to return null silently = the very bug class of this round.
  # In interpolation, though, the interpreter catches the fragment eval error and returns a LITERAL →
  # the VM also wraps the fragment in a runtime try/catch (parity). A defined one must not break.
  $su = "";
  try { $sx = $kesinlikle_yok; $su .= "SIZDI" } catch ($e) { $su .= $e }
  $sd = 5;
  $o .= "S:" . $su . "|{$hic_yok}|{$sd}-{$sd * 2};";
  # 256+ index region — the CALL_BUILTIN index is 16-bit (the NOP hint's b field high byte).
  # Regression lock for the silent-truncation bug left over from the 8-bit era: when the list grew to 285,
  # cache::size (index 256 → 0) called PRINT and returned null. This category verifies on all three engines
  # that builtins with index 256+ go to the CORRECT function.
  cache::set("dk1", "v1"); cache::set("dk2", "v2")
  queue::clear("dq"); queue::push("dq", "is1")
  $o .= "T:" . cache::size() . "," . count(cache::keys()) . "," . queue::peek("dq") . ","
             . template::escape("<x>") . "," . validator::check("a@b.co", "email") . ";";
  return $o;
}

function dif_p6() {
  $o = "";
  # U — COMPOUND ASSIGNMENT (+= -= *= /= %= .=) in every scope. It was MISSING from the guard and that is exactly why it
  # slipped through: the compiler's TOP-LEVEL GLOBAL branch ignored e.op → "$t += $i" was compiled as just
  # "$t = $i". Result: interpreter CORRECT, VM SILENTLY WRONG (sums/
  # string accumulations broken, no error). The other three branches (index, local, in-function)
  # were correct — that is why web routes worked while top-level scripts were broken.
  # SCOPE CORRECTION (2026-09-30, measured by fault injection): this category runs INSIDE A FUNCTION
  # → it locks the local chain, local string accumulation, accumulation in a loop, array element and
  # (together with dif_compound) the in-function branches. The TOP-LEVEL GLOBAL branch is NOT TESTED
  # HERE (the old comment said "global"). That branch is locked by the separate
  # "top-level compound" section in differential_test.sh: when e.op was ignored in the global branch that section FAILed,
  # this category and the regression files did not.
  $ug = 1; $ug += 2; $ug *= 3; $ug -= 1; $ug /= 4; $ug %= 3;      # yerel zincir
  $us = "a"; $us .= "b"; $us .= "c";                              # yerel string birikimi
  $ut = 0; $uk = 0;
  while ($uk < 5) { $ut += $uk; $uk = $uk + 1 }                   # accumulation in a loop
  $ul = [10]; $ul[0] += 5;                                        # array element
  # V — date:: CALENDAR validation + signed diff. date:: was completely MISSING from the guard.
  # parse() did a coarse range check (day <= 31) → 2024-04-31 / 2023-02-29 passed and were SILENTLY
  # shifted by mktime to 1 May / 1 March (is_valid said false —
  # the code's own goal was "consistent with is_valid" but the month-specific day limit was missing).
  # Contract: an impossible date is an ERROR, a valid date is kept as is, diff stays SIGNED.
  $vb = "";
  try { date::parse("2024-04-31", "Y-m-d"); $vb .= "KACTI" } catch ($e) { $vb .= "red" }
  try { date::parse("2023-02-29", "Y-m-d"); $vb .= "KACTI" } catch ($e) { $vb .= "-red" }
  $o .= "V:" . $vb . "," . date::parse("2024-02-29", "Y-m-d") . ","
             . date::is_valid("2024-04-31") . "," . date::is_valid("2024-02-29") . ","
             . date::diff(date::parse("2024-01-01","Y-m-d"), date::parse("2024-01-10","Y-m-d"), "days") . ";";
  $o .= "U:" . $ug . "," . $us . "," . $ut . "," . $ul[0] . "," . dif_compound() . ";";
  return $o;
}

function dif_p7() {
  $o = "";
  # count/len — must NOT count the assoc sentinel. VM builtins (main b[2], http_main setup/req[2])
  # SKIPPED the __assoc__ check → count(["x"=>1])=3 (sentinel+2n), diverges from interpreter=1.
  # This case would have been RED before (there was no assoc test, the bug was differential-invisible). Expected: 2,2,4,0,3.
  $ca = ["x"=>1, "y"=>2]; $cp = [1,2,3,4];
  $o .= "W:" . count($ca) . "," . len($ca) . "," . count($cp) . "," . count([]) . "," . len("abc") . ";";
  # String immutability — $s[0]="X" must FAIL LOUD and identically on the CLI and the web. The VM
  # used to silently ignore it (silent-wrong) while the interpreter threw; now both throw the
  # same message and the string is unchanged. Locks the string-view precondition.
  $im = ""; $ss = "abc";
  try { $ss[0] = "X"; $im = "MUTATED:" . $ss } catch ($e) { $im = $ss . "|" . $e }
  $o .= "X:" . $im . ";";
  # Y: struct — the default is applied · field order is as in the declaration even if the literal is given in reverse order ·
  # dynamic default · a literal with unknown fields gives the SAME error in CLI and web ·
  # shape is FIXED — assigning to a field not declared gives the SAME error in CLI and web.
  $su1 = DifUser{name: "Can"}
  $su2 = DifUser{role: "admin", name: "Ada"}
  $ye = "";
  try { $sbad = DifUser{nmae: "x"}; $ye = "NO-ERROR" } catch ($e) { $ye = "" . $e }
  $yx = "";
  try { $su1.extra = 1; $yx = "NO-ERROR" } catch ($e) { $yx = "" . $e }
  $ty = DifTyped{s: "a"}; $ty.n += 2
  $yt1 = ""; try { $tb = DifTyped{n: "x"}; $yt1 = "NO-ERROR" } catch ($e) { $yt1 = "" . $e }
  $yt2 = ""; try { $ty.s = 5; $yt2 = "NO-ERROR" } catch ($e) { $yt2 = "" . $e }
  $o .= "Y2:" . json::encode($ty) . "," . $yt1 . "," . $yt2 . ";";
  $o .= "Y:" . $su1.role . "," . json::encode($su2) . "," . $su1.tag . "," . $ye . "," . $yx . "," . json::encode($su1) . ";";
  return $o;
}

function run_all() {
  return dif_p1() . dif_p2() . dif_p3() . dif_p4() . dif_p5() . dif_p6() . dif_p7();
}

# Function-local compound assignment — must give the same result as the global branch.
function dif_compound() {
  $x = 1; $x += 2; $x *= 3;
  $y = "p"; $y .= "q";
  return $x . $y;
}
