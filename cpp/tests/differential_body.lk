use array;
use cache;
use queue;
use template;
use validator;
use type;
use crypto;
use date;
function dif_fib($n) { if ($n < 2) { return $n } return dif_fib($n-1) + dif_fib($n-2) }

# Struct VM paritesi (2026-09-30): VM struct tanımını hiç bilmiyordu → CLI-VM ve web-VM'de
# varsayılanlar uygulanmıyor, bilinmeyen alanlı literal sessizce kabul ediliyordu; hiçbir
# test struct kullanmadığı için bu kategori yoktu. ÜST SEVİYEDE bildirildi: web'de kurulum
# VM'i çalıştırır ve tanım vm_setup_globals ile isteğin VM'ine taşınır (üretim yolu).
# `tag: $dif_sd` dinamik varsayılan — bildirim anında değerlendirilir (tree-walk gibi).
$dif_sd = "dyn"
struct DifUser {
  name any
  role any = "member"
  tag any = $dif_sd
}
# LOOK 2 tipli struct (ad + tip + varsayılan) — üç motorda aynı sıfır değeri ve aynı hata.
struct DifTyped {
  n int = 1
  s string
  f ?float
  xs array
}

# GÖVDE KATEGORİ FONKSİYONLARINA BÖLÜNDÜ (2026-09-30). Tek dev run_all() VM'in 255-register
# sınırını aşıyordu → CLI VE web TÜM programı SESSİZCE yorumlayıcıya veriyordu; bu guard'ın
# "tree-walk == CLI-VM == web-VM" satırı gövde için yorumlayıcı×3 idi (bugünkü derleyiciyle
# ~2026-07-18'den beri). Artık her parça sınırın çok altında ve differential_test.sh CLI+web
# sütunlarını LOOK_VM_STRICT=1 ile koşturur: VM derleyemezse guard KIRMIZI olur, sessiz geçmez.
# YENİ KATEGORİ EKLERKEN: tek bir dif_pN'i şişirme — yeni bir dif_pN aç.
function dif_p1() {
  $o = "";
  # aritmetik + taşma + INT64 uç + bölme/modulo
  $o .= "A:" . (3+4*2) . "," . (10/3) . "," . (10%3) . "," . (2**10) . "," . (-9999999999) . "," . (7/2) . ";";
  # string + COW aliasing + concat
  $s="ab"; $t=$s; $s.="cd"; $u="x"; $u.=$u; $u.=$u;
  $o .= "B:" . $s . "," . $t . "," . $u . ";";
  # karşılaştırma + coercion
  $o .= "C:" . (5==5.0) . "," . ("5"==5) . "," . ("a"<"b") . "," . (0=="") . "," . (1<2) . ";";
  # bitwise/shift
  $o .= "D:" . (12&10) . "," . (12|1) . "," . (12^5) . "," . (1<<4) . "," . (256>>2) . "," . (~5) . ";";
  # array + push/pop + index + nested
  $a=[1,2,3]; push($a,4); $last=pop($a); $a[0]=99; $n=[[1,2],[3,4]];
  $o .= "E:" . json::encode($a) . "," . $last . "," . $n[1][0] . ";";
  # object + member + index atama
  $m=["name"=>"ali","age"=>30]; $m.age=31; $m["city"]="ist";
  $o .= "F:" . $m.name . "," . $m.age . "," . $m["city"] . ";";
  return $o;
}

function dif_p2() {
  $o = "";
  # higher-order + implicit capture + explicit use + user-fn callback
  $mul=3; $mp=array::map([1,2,3], fn($x)=>$x*$mul);
  $fl=array::filter([1,2,3,4,5], fn($x)=>$x>2);
  $rd=array::reduce([1,2,3,4], fn($ac,$x)=>$ac+$x, 0);
  $base=100; $f=fn($x) use($base) => $base+$x;
  $o .= "G:" . json::encode($mp) . "," . json::encode($fl) . "," . $rd . "," . $f(5) . ";";
  # control flow: while+continue+break, if/else, ternary
  $sum=0; $i=0; while($i<6){ if($i==2){$i=$i+1; continue;} if($i==5){break;} $sum=$sum+$i; $i=$i+1; }
  $o .= "H:" . $sum . "," . (5>3?"y":"n") . ";";
  # string fonksiyonları + builtin alias
  $o .= "I:" . len("merhaba") . "," . count([1,2,3]) . "," . intval("42") . "," . strtoupper("abc") . ";";
  # join
  $o .= "J:" . join(["a","b","c"], "-") . ";";
  return $o;
}

function dif_p3() {
  $o = "";
  # try/catch — C++ runtime hata (bölme/mod sıfır) + LOOK throw + finally + iç içe
  # (VM try/catch operatör exception'larını da yakalamalı — interpreter gibi)
  $k=""; try{ $qx=10/0 }catch($e){ $k.="d" }
  try{ $qy=10%0 }catch($e){ $k.="m" }
  try{ throw "boom" }catch($e){ $k.=$e }
  $fin=""; try{ $qz=1/0 }catch($e){ $fin.="c" }finally{ $fin.="f" }
  # fonksiyon-sınırını geçen throw: doğrudan çağrılan LOOK fn içinde throw → çağıranın
  # catch'i yakalamalı. VM THROW opcode frame-pop + goto call_dispatch (salt break bayat
  # proto/sarkan frame → sessiz duruş, VM≠interpreter; 2026-08-11 fix). C++ builtin callback
  # yolu (aşağıda array::map, satır ~63) FARKLI eksen — bu doğrudan-CALL yolunu kilitler.
  function _thrower() { throw "xfn" }
  try { _thrower() } catch($e) { $k .= "|" . $e }
  $o .= "K:" . $k . "|" . $fin . ";";
  # string interpolation — '$'-önekli expression formları (VM==interpreter)
  $ia=5; $ib=3; $iarr=[10,20,30]; $im=["name"=>"ali","age"=>30];
  $o .= "L:{$ia}-{$ia + $ib}-{$iarr[1]}-{$im.name}-{$im.age * 2};";
  # type:: — is_function VM closure'ı (BYTECODE_FN) da tanımalı
  $o .= "M:" . type::is_int(5) . "," . type::is_string("a") . "," . type::is_array([1]) . ","
             . type::is_function(fn($x)=>$x) . "," . type::of(1.5) . "," . type::to_int("42") . ";";
  # crypto:: — deterministik olanlar (random/uuid hariç: değer karşılaştırılamaz)
  $o .= "N:" . crypto::base64_encode("merhaba") . "," . crypto::base64_decode("bWVyaGFiYQ==") . ","
             . crypto::hex_encode("ab") . "," . crypto::hmac_sha256("msg","key") . ","
             . crypto::constant_compare("a","b") . ";";
  return $o;
}

function dif_p4() {
  $o = "";
  # VM↔interpreter köprüsü üzerinden exception: array::map callback'i iç run()'da çalışır.
  # throw/runtime-hata DIŞ try/catch'e ulaşmalı (try_floor_ + LookVmThrow). Taban yoksa
  # iç run() dış handler'a atlar → call stack bozulur, aradaki C++ catch (ör. db::transaction
  # ROLLBACK) atlanır. Değer de korunmalı ("stop" — e.what() değil).
  $bo = "";
  try { $bm = array::map([1,2,3], function($x){ if ($x == 2) { throw "stop" } return $x }); $bo .= "no" }
  catch ($e) { $bo .= "caught:" . $e }
  try { $bm2 = array::map([1,0], function($x){ return 10 / $x }); $bo .= "|no" }
  catch ($e) { $bo .= "|rt" }
  $o .= "O:" . $bo . "|" . json::encode(array::map([1,2], function($x){ return $x * 10 })) . ";";
  # Higher-order kapsam tamamlama: sort(comparator)/find/any/all — guard'da YOKTU,
  # bu yüzden array::sort'un comparator'ı VM'de SESSİZCE yok sayması kaçmıştı
  # (callback FUNCTION-only kontrolü BYTECODE_FN'i reddediyordu → varsayılan sıra).
  $o .= "P:" . json::encode(array::sort([3,1,4,1,5], function($a,$b){ return $b - $a })) . ","
             . array::find([1,2,3,4], function($x){ return $x > 2 }) . ","
             . array::any([1,2,3], function($x){ return $x == 9 }) . ","
             . array::all([2,4], function($x){ return $x % 2 == 0 }) . ","
             . json::encode(array::sort([3,1,2])) . ";";
  # error::new TİPLİ throw — error::new DEĞER DÖNDÜRMEZ, LookRuntimeError(payload) fırlatır.
  # VM dispatch'i payload'ı korumalı (has_value ? value : message); e.what() string'ine
  # düşürülürse error::is() false döner, error::message() tüm nesneyi verir → sessizce
  # yanlış hata yönetimi. Köprü üzerinden (array::map callback) de korunmalı.
  $eo = "";
  try { throw error::new("E_DB", "baglanti yok") }
  catch ($e) { $eo .= error::message($e) . "," . error::is($e, "E_DB") . "," . error::is($e, "E_X") }
  try { $em = array::map([1,2], function($x){ if ($x == 2) { throw error::new("E_MAP", "iki") } return $x }) }
  catch ($e) { $eo .= "|" . error::message($e) . "," . error::is($e, "E_MAP") }
  $o .= "Q:" . $eo . ";";
  # Çekirdek dil kapsamı: recursion, iç içe closure, döngü-değişkeni yakalama, foreach assoc
  $mk = function($base){ return function($x) use ($base) { return $base + $x } }
  $add10 = $mk(10)
  $fns = []; $ri = 0
  while ($ri < 3) { $rv = $ri; push($fns, function() use ($rv) { return $rv * 100 }); $ri = $ri + 1 }
  $rm = ["a"=>1, "b"=>2]; $rs = ""
  foreach ($rm as $rk => $rvv) { $rs .= $rk . $rvv }
  # 3b kilidi: use()-yakalanan FOREACH loop-local VM'de array-sarılı DÖNMEMELİ (["x"] değil
  # "x"). json::encode wrap'ı ifşa eder; eski bug'da VM explicit-use() capture'ın CELL [0]
  # deref'ini atlıyordu → tree-walk "x", VM ["x"] = ayrışma. İki motor da "pq" vermeli.
  $cap = []; foreach (["p","q"] as $cx) { push($cap, function() use ($cx) { return $cx }) }
  $capj = json::encode($cap[0]()) . "-" . json::encode($cap[1]());
  $o .= "R:" . dif_fib(12) . "," . $add10(5) . "," . $fns[0]() . $fns[1]() . $fns[2]() . "," . $rs . "," . $capj . ";";
  return $o;
}

function dif_p5() {
  $o = "";
  # Tanımsız değişken — STRICT (Go/Node bandı; PHP'den yalnız dağıtım alınıyor, semantik
  # değil). Eskiden VM sessizce null dönüyordu = bu turun bug sınıfının ta kendisi.
  # İnterpolasyonda ise interpreter fragment eval-hatasını yakalayıp LİTERAL döner →
  # VM de fragment'ı runtime try/catch ile sarar (parity). Tanımlı olan bozulmamalı.
  $su = "";
  try { $sx = $kesinlikle_yok; $su .= "SIZDI" } catch ($e) { $su .= $e }
  $sd = 5;
  $o .= "S:" . $su . "|{$hic_yok}|{$sd}-{$sd * 2};";
  # 256+ indeks bölgesi — CALL_BUILTIN indeksi 16-bit (NOP hint'in b alanı yüksek byte).
  # 8-bit çağdan kalan sessiz-kırpılma bug'ının regresyon kilidi: liste 285'e çıktığında
  # cache::size (index 256 → 0) PRINT'i çağırıp null dönmüştü. Bu kategori 256+ indeksli
  # builtin'lerin DOĞRU fonksiyona gittiğini üç motorda birden doğrular.
  cache::set("dk1", "v1"); cache::set("dk2", "v2")
  queue::clear("dq"); queue::push("dq", "is1")
  $o .= "T:" . cache::size() . "," . count(cache::keys()) . "," . queue::peek("dq") . ","
             . template::escape("<x>") . "," . validator::check("a@b.co", "email") . ";";
  return $o;
}

function dif_p6() {
  $o = "";
  # U — BİLEŞİK ATAMA (+= -= *= /= %= .=) her kapsamda. Guard'da YOKTU ve tam bu yüzden
  # kaçtı: compiler'ın TOP-LEVEL GLOBAL dalı e.op'u yok sayıyordu → "$t += $i" sadece
  # "$t = $i" derleniyordu. Sonuç: interpreter DOĞRU, VM SESSİZCE YANLIŞ (toplamlar/
  # string birikimleri bozuk, hata yok). Diğer üç dal (index, local, fonksiyon-içi)
  # doğruydu — o yüzden web route'ları çalışıyor, top-level script'ler bozuktu.
  # KAPSAM DÜZELTMESİ (2026-09-30, hata enjeksiyonuyla ölçüldü): bu kategori bir FONKSİYONUN
  # İÇİNDE koşar → yerel zincir, yerel string birikimi, döngüde birikim, dizi elemanı ve
  # (dif_compound ile) fonksiyon-içi dalları kilitler. ÜST-SEVİYE GLOBAL dalı BURADA TEST
  # EDİLMEZ (eski yorum "global" diyordu). O dalı differential_test.sh'deki ayrı
  # "top-level compound" bölümü kilitler: global dalda e.op yok sayılınca o bölüm FAIL verdi,
  # bu kategori ve regresyon dosyaları vermedi.
  $ug = 1; $ug += 2; $ug *= 3; $ug -= 1; $ug /= 4; $ug %= 3;      # yerel zincir
  $us = "a"; $us .= "b"; $us .= "c";                              # yerel string birikimi
  $ut = 0; $uk = 0;
  while ($uk < 5) { $ut += $uk; $uk = $uk + 1 }                   # döngüde birikim
  $ul = [10]; $ul[0] += 5;                                        # dizi elemanı
  # V — date:: TAKVIM dogrulamasi + isaretli diff. Guard'da date:: HIC yoktu.
  # parse() kaba aralik kontrolu yapiyordu (gun <= 31) → 2024-04-31 / 2023-02-29 gecip
  # mktime ile SESSIZCE 1 Mayis / 1 Mart'a kayiyordu (is_valid ise false diyordu —
  # kodun kendi hedefi "is_valid ile tutarli" idi ama ay-ozgu gun siniri yoktu).
  # Sozlesme: imkansiz tarih HATA, gecerli tarih aynen, diff ISARETLI kalir.
  $vb = "";
  try { date::parse("2024-04-31", "Y-m-d"); $vb .= "KACTI" } catch ($e) { $vb .= "red" }
  try { date::parse("2023-02-29", "Y-m-d"); $vb .= "KACTI" } catch ($e) { $vb .= "-red" }
  $o .= "V:" . $vb . "," . date::parse("2024-02-29", "Y-m-d") . ","
             . date::is_valid("2024-04-31") . "," . date::is_valid("2024-02-29") . ","
             . date::diff(date::parse("2024-01-01","Y-m-d"), date::parse("2024-01-10","Y-m-d"), "days") . ";";
  $o .= "U:" . $ug . "," . $us . "," . $ut . "," . $ul[0] . "," . dif_compound() . ";";
  return $o;
}

function dif_p7() {
  $o = "";
  # count/len — assoc sentinel'i SAYMAMALI. VM builtin'leri (main b[2], http_main setup/req[2])
  # __assoc__ kontrolunu ATLIYORDU → count(["x"=>1])=3 (sentinel+2n), interpreter=1 ile ayrisir.
  # Bu case eskiden RED verirdi (assoc testi yoktu, bug differential-gorunmezdi). Beklenen: 2,2,4,0,3.
  $ca = ["x"=>1, "y"=>2]; $cp = [1,2,3,4];
  $o .= "W:" . count($ca) . "," . len($ca) . "," . count($cp) . "," . count([]) . "," . len("abc") . ";";
  # String immutability — $s[0]="X" must FAIL LOUD and identically in both engines. The VM
  # used to silently ignore it (silent-wrong) while the interpreter threw; now both throw the
  # same message and the string is unchanged. Locks the string-view precondition.
  $im = ""; $ss = "abc";
  try { $ss[0] = "X"; $im = "MUTATED:" . $ss } catch ($e) { $im = $ss . "|" . $e }
  $o .= "X:" . $im . ";";
  # Y: struct — varsayılan uygulanır · literal ters sırada verilse de alan sırası bildirimdeki
  # gibi · dinamik varsayılan · bilinmeyen alanlı literal iki motorda AYNI hatayı verir ·
  # LOOK 2: şekil SABİT — sonradan bildirilmemiş alana atama iki motorda AYNI hatayı verir.
  $su1 = DifUser{name: "Can"}
  $su2 = DifUser{role: "admin", name: "Ada"}
  $ye = "";
  try { $sbad = DifUser{nmae: "x"}; $ye = "NO-ERROR" } catch ($e) { $ye = "" . $e }
  $yx = "";
  try { $su1.extra = 1; $yx = "NO-ERROR" } catch ($e) { $yx = "" . $e }
  $ty = DifTyped{s: "a"}; $ty.n += 2
  $yt1 = ""; try { $tb = DifTyped{n: "x"}; $yt1 = "NO-ERROR" } catch ($e) { $yt1 = "" . $e }
  $yt2 = ""; try { $ty.s = 5; $yt2 = "NO-ERROR" } catch ($e) { $yt2 = "" . $e }
  $o .= "Y2:" . json::encode($ty) . "," . $yt1 . "," . $yt2 . ";";
  $o .= "Y:" . $su1.role . "," . json::encode($su2) . "," . $su1.tag . "," . $ye . "," . $yx . "," . json::encode($su1) . ";";
  return $o;
}

function run_all() {
  return dif_p1() . dif_p2() . dif_p3() . dif_p4() . dif_p5() . dif_p6() . dif_p7();
}

# Fonksiyon-içi (local) bileşik atama — global dalıyla aynı sonucu vermeli.
function dif_compound() {
  $x = 1; $x += 2; $x *= 3;
  $y = "p"; $y .= "q";
  return $x . $y;
}
